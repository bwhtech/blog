---
/**
 * The platforms an author can link to. Adding one means adding an icon here and
 * a matching key to the authors schema in src/content.config.ts.
 */
const PLATFORMS = {
	github: { label: 'GitHub', viewBox: '0 0 16 16', filled: true },
	instagram: { label: 'Instagram', viewBox: '0 0 24 24', filled: false },
	linkedin: { label: 'LinkedIn', viewBox: '0 0 20 20', filled: true },
} as const;

type Platform = keyof typeof PLATFORMS;

interface Props {
	social?: Partial<Record<Platform, string>>;
}

const { social = {} } = Astro.props;
const links = (Object.keys(PLATFORMS) as Platform[])
	.filter((platform) => social[platform])
	.map((platform) => ({ platform, ...PLATFORMS[platform], url: social[platform]! }));
---

{
	links.length > 0 && (
		<ul class="mt-8 flex flex-wrap items-center gap-4">
			{links.map(({ filled, label, platform, url, viewBox }) => (
				<li>
					<a
						class="block text-ink-gray-4 transition-colors hover:text-ink-gray-8"
						href={url}
						rel="me noopener"
						target="_blank"
						aria-label={label}
						title={label}
					>
						<svg
							class="size-5"
							viewBox={viewBox}
							fill={filled ? 'currentColor' : 'none'}
							stroke={filled ? undefined : 'currentColor'}
							stroke-width={filled ? undefined : '1.75'}
							stroke-linecap={filled ? undefined : 'round'}
							stroke-linejoin={filled ? undefined : 'round'}
							aria-hidden="true"
						>
							{platform === 'github' && (
								<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8" />
							)}
							{platform === 'instagram' && (
								<>
									<rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
									<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
									<line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
								</>
							)}
							{platform === 'linkedin' && (
								<path d="M16.6281 2.25586H3.4132C2.78868 2.25586 2.28906 2.75548 2.28906 3.38V16.6198C2.28906 17.2194 2.78868 17.744 3.4132 17.744H16.5782C17.2027 17.744 17.7023 17.2444 17.7023 16.6198V3.35502C17.7523 2.75548 17.2526 2.25586 16.6281 2.25586ZM6.86058 15.4208H4.58731V8.05142H6.86058V15.4208ZM5.71145 7.02721C4.96203 7.02721 4.38746 6.42767 4.38746 5.70322C4.38746 4.97878 4.98701 4.37923 5.71145 4.37923C6.4359 4.37923 7.03544 4.97878 7.03544 5.70322C7.03544 6.42767 6.48586 7.02721 5.71145 7.02721ZM15.479 15.4208H13.2057V11.8485C13.2057 10.9992 13.1808 9.875 12.0067 9.875C10.8076 9.875 10.6327 10.8243 10.6327 11.7736V15.4208H8.35939V8.05142H10.5827V9.07564H10.6077C10.9325 8.47607 11.6569 7.87656 12.7811 7.87656C15.1043 7.87656 15.5289 9.37542 15.5289 11.4238V15.4208H15.479Z" />
							)}
						</svg>
					</a>
				</li>
			))}
		</ul>
	)
}
