---
/**
 * The platforms an author can link to. Adding one means adding an icon here and
 * a matching key to the authors schema in src/content.config.ts.
 */
const PLATFORMS = {
	github: 'GitHub',
	instagram: 'Instagram',
	linkedin: 'LinkedIn',
} as const;

type Platform = keyof typeof PLATFORMS;

interface Props {
	social?: Partial<Record<Platform, string>>;
}

const { social = {} } = Astro.props;
const links = (Object.keys(PLATFORMS) as Platform[])
	.filter((platform) => social[platform])
	.map((platform) => ({ platform, label: PLATFORMS[platform], url: social[platform]! }));
---

{
	links.length > 0 && (
		<ul class="mt-8 flex flex-wrap items-center gap-4">
			{links.map(({ label, platform, url }) => (
				<li>
					<a
						class="block text-ink-gray-4 transition-colors hover:text-ink-gray-8"
						href={url}
						rel="me noopener"
						target="_blank"
						aria-label={label}
						title={label}
					>
						<svg
							class="size-5"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							{platform === 'github' && (
								<>
									<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
									<path d="M9 18c-4.51 2-5-2-7-2" />
								</>
							)}
							{platform === 'instagram' && (
								<>
									<rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
									<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
									<line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
								</>
							)}
							{platform === 'linkedin' && (
								<>
									<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
									<rect width="4" height="12" x="2" y="9" />
									<circle cx="4" cy="4" r="2" />
								</>
							)}
						</svg>
					</a>
				</li>
			))}
		</ul>
	)
}
