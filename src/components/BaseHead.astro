---
import { SITE_TITLE } from '../consts';

/** Open Graph images are 1200x630, the size crawlers expect. */
const OG_SIZE = { width: 1200, height: 630 };

interface Props {
	title: string;
	description: string;
	author?: string;
	image?: ImageMetadata;
	/** A path under public/, for pages whose card is a pre-rendered OG image. */
	ogImage?: string;
	publishedTime?: Date;
	tags?: string[];
	type?: 'article' | 'website';
}

const {
	author,
	description,
	image,
	ogImage,
	publishedTime,
	tags = [],
	title,
	type = 'website',
} = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const feedURL = Astro.site ? new URL('rss.xml', Astro.site) : undefined;
const card = image ? { src: image.src, width: image.width, height: image.height } : undefined;
const socialCard = ogImage ? { src: ogImage, ...OG_SIZE } : card;
// Social crawlers do not resolve relative paths, so the built asset URL has to be absolute.
const socialImage = socialCard && Astro.site ? new URL(socialCard.src, Astro.site) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{feedURL && <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={feedURL} />}
{canonicalURL && <link rel="canonical" href={canonicalURL} />}
<title>{title}</title>
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonicalURL && <meta property="og:url" content={canonicalURL} />}
{
	socialImage && socialCard && (
		<>
			<meta property="og:image" content={socialImage} />
			<meta property="og:image:width" content={String(socialCard.width)} />
			<meta property="og:image:height" content={String(socialCard.height)} />
		</>
	)
}
{author && <meta name="author" content={author} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
