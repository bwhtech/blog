---
import { Image } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';

import { getCategoryLabel, getPostHref } from '../utils/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	/** Off on an author page, where every post has the same author. */
	showAuthor?: boolean;
}

const { posts, showAuthor = true } = Astro.props;
const postItems = await Promise.all(
	posts.map(async (post) => ({
		post,
		author: await getEntry(post.data.author),
		category: getCategoryLabel(post),
	})),
);
---

{
	postItems.length > 0 ? (
		<ul class="divide-y divide-outline-gray-1 border-y border-outline-gray-1">
			{postItems.map(({ post, author, category }) => (
				<li>
					<a
						class="group -mx-4 grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-4 px-4 py-5 no-underline transition-colors hover:bg-surface-gray-1 sm:-mx-5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6 sm:px-5 sm:py-6"
						href={getPostHref(post)}
					>
						{
							post.data.image ? (
								<Image
									class="aspect-video w-full rounded-6 border border-outline-gray-1 bg-surface-gray-1 object-cover"
									src={post.data.image}
									alt=""
									width={352}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="grid aspect-video w-full place-items-center rounded-6 border border-outline-gray-1 bg-surface-gray-1 text-sm-medium text-ink-gray-4">
									BWH
								</div>
							)
						}
						<div class="min-w-0 py-0.5 sm:py-1">
							<h2 class="text-lg-medium text-ink-gray-8 transition-colors group-hover:text-ink-gray-9 sm:text-2xl sm:font-medium">
								{post.data.title}
							</h2>
							<p class="mt-2 line-clamp-2 text-p-sm text-ink-gray-5 sm:text-p-base">
								{post.data.description}
							</p>
							<p class="mt-3 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm tabular-nums text-ink-gray-4">
								<span>
									In <span class="text-ink-gray-5">{category}</span>
									{showAuthor && (
										<>
											{' '}
											by <span class="text-ink-gray-5">{author?.data.name ?? 'BWH'}</span>
										</>
									)}
								</span>
								<span class="whitespace-nowrap">
									<span aria-hidden="true">·</span>{' '}
									<FormattedDate date={post.data.pubDate} />
								</span>
							</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	) : (
		<p class="border-y border-outline-gray-1 py-12 text-center text-p-base text-ink-gray-5">
			No posts have been published yet.
		</p>
	)
}
