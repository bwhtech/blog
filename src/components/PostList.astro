---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import { getCategoryLabel, getPostAuthors, getPostHref } from '../utils/posts';
import AuthorNames from './AuthorNames.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	/** Off on an author page. A post with more than one author still shows
	    the full byline there, so no author is listed differently from another. */
	showSoleAuthor?: boolean;
}

const { posts, showSoleAuthor = true } = Astro.props;
const postItems = await Promise.all(
	posts.map(async (post) => ({
		post,
		authors: await getPostAuthors(post.data.authors),
		category: getCategoryLabel(post),
	})),
);
---

{
	postItems.length > 0 ? (
		<ul class="divide-y divide-outline-gray-1 border-y border-outline-gray-1">
			{postItems.map(({ post, authors, category }) => (
				<li>
					<a
						class="group -mx-4 grid grid-cols-[6.5rem_minmax(0,1fr)] items-start gap-4 px-4 py-5 no-underline transition-colors hover:bg-surface-gray-1 sm:-mx-5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6 sm:px-5 sm:py-6"
						href={getPostHref(post)}
					>
						{
							post.data.image ? (
								<Image
									class="aspect-video w-full rounded-6 border border-outline-gray-1 bg-surface-gray-1 object-cover"
									src={post.data.image}
									alt=""
									width={352}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="grid aspect-video w-full place-items-center rounded-6 border border-outline-gray-1 bg-surface-gray-1 text-sm-medium text-ink-gray-4">
									BWH
								</div>
							)
						}
						<div class="min-w-0 py-0.5 sm:py-1">
							<h2 class="text-lg-medium text-ink-gray-8 transition-colors group-hover:text-ink-gray-9 sm:text-2xl sm:font-medium">
								{post.data.title}
							</h2>
							<p class="mt-2 line-clamp-2 text-p-sm text-ink-gray-5 sm:text-p-base">
								{post.data.description}
							</p>
							<!-- Date first: a long byline then wraps inside the names, like any
							     sentence, instead of pushing a lone "· date" onto the next line. -->
							<p class="mt-3 text-sm tabular-nums text-ink-gray-4">
								<span class="whitespace-nowrap">
									<FormattedDate date={post.data.pubDate} /> <span aria-hidden="true">·</span>
								</span>{' '}
								In <span class="text-ink-gray-5">{category}</span>
								{(showSoleAuthor || authors.length > 1) && (
									<>
										{' '}
										by <AuthorNames authors={authors} nameClass="whitespace-nowrap text-ink-gray-5" />
									</>
								)}
							</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	) : (
		<p class="border-y border-outline-gray-1 py-12 text-center text-p-base text-ink-gray-5">
			No posts have been published yet.
		</p>
	)
}
