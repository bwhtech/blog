---
/**
 * The open-source stack, as app icons drifting in a loose cluster. Each one
 * bobs on its own slow loop, the cluster leans a little toward the pointer,
 * and hovering or focusing an icon lifts it and says what it is. Without
 * motion the icons sit still with their names showing.
 */
import { STACK } from '../../data/landing';

// Where each icon sits (percent of the stage), how big it is, how its loop
// runs, and which way its card opens so it stays inside the stage.
const PLACES = [
	{ x: 20, y: 32, size: 96, period: 6.4, delay: -1.2, align: 'start', open: 'down' },
	{ x: 54, y: 20, size: 80, period: 7.2, delay: -3.4, align: 'center', open: 'down' },
	{ x: 82, y: 38, size: 72, period: 5.8, delay: -0.6, align: 'end', open: 'down' },
	{ x: 30, y: 76, size: 72, period: 6.9, delay: -4.1, align: 'start', open: 'up' },
	{ x: 64, y: 68, size: 64, period: 7.8, delay: -2.3, align: 'center', open: 'up' },
];
const ABOUT: Record<string, { href: string; body: string }> = {
	'Frappe Framework': { href: 'https://frappe.io/framework', body: 'The full-stack web framework, in Python and JavaScript, that everything here is built on.' },
	ERPNext: { href: 'https://frappe.io/erpnext', body: 'Open-source ERP: accounts, inventory, buying, selling and more.' },
	'Frappe HR': { href: 'https://frappe.io/hr', body: 'Open-source HR and payroll, built on Frappe.' },
	'Frappe Insights': { href: 'https://frappe.io/insights', body: 'Open-source reports and dashboards on your own data.' },
	'Frappe UI': { href: 'https://ui.frappe.io', body: "The Vue component library behind Frappe's apps." },
};
---

<div class="orbit" data-orbit>
	<div class="cluster" data-cluster>
		{STACK.map((item, i) => {
			const place = PLACES[i];
			return (
				<a
					href={ABOUT[item.label].href}
					target="_blank"
					rel="noopener"
					class="app"
					data-align={place.align}
					data-open={place.open}
					style={`left:${place.x}%;top:${place.y}%;--size:${place.size}px;--period:${place.period}s;--delay:${place.delay}s`}
				>
					<span class="bob">
						<span class="icon"><img src={item.src} alt="" width={place.size} height={place.size} /></span>
					</span>
					<span class="name">{item.label}</span>
					<span class="info" role="tooltip">
						<b>{item.label}</b>
						<span>{ABOUT[item.label].body}</span>
						<em>Open source<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></em>
					</span>
				</a>
			);
		})}
	</div>
</div>

<style>
	.orbit {
		position: relative;
		height: 420px;
		border: 1px solid var(--outline-gray-1);
		border-radius: 16px;
		/* A faint dot grid, so the icons read as floating over a surface. */
		background:
			radial-gradient(circle at 1px 1px, var(--outline-gray-2) 1px, transparent 0) 0 0 / 20px 20px,
			var(--surface-gray-1);
	}
	@media (max-width: 639px) {
		.orbit {
			height: 340px;
		}
		.app {
			scale: 0.8;
		}
	}
	.cluster {
		position: absolute;
		inset: 0;
		transition: transform 900ms var(--lab-ease);
	}
	.app {
		position: absolute;
		z-index: 1;
		display: flex;
		width: var(--size);
		flex-direction: column;
		align-items: center;
		translate: -50% -50%;
		color: inherit;
		text-decoration: none;
		outline: none;
	}
	.app:hover,
	.app:focus-visible {
		z-index: 3;
	}
	.bob {
		display: block;
	}
	html[data-motion='on'] .bob {
		animation: bob var(--period) ease-in-out var(--delay) infinite;
	}
	@keyframes bob {
		0%,
		100% {
			transform: translateY(0) rotate(-2deg);
		}
		50% {
			transform: translateY(-12px) rotate(2deg);
		}
	}
	.app:hover .bob,
	.app:focus-visible .bob {
		animation-play-state: paused;
	}
	.icon {
		display: flex;
		width: var(--size);
		height: var(--size);
		align-items: center;
		justify-content: center;
		border: 1px solid var(--outline-gray-1);
		border-radius: calc(var(--size) * 0.26);
		background: var(--surface-base);
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.06),
			0 14px 30px -14px rgb(0 0 0 / 0.3);
		transition:
			transform 500ms var(--lab-ease),
			box-shadow 500ms var(--lab-ease),
			opacity 300ms var(--lab-ease);
	}
	.icon img {
		width: 54%;
		height: 54%;
	}
	.app:hover .icon,
	.app:focus-visible .icon {
		transform: scale(1.1);
		box-shadow:
			0 2px 4px rgb(0 0 0 / 0.08),
			0 22px 40px -16px rgb(0 0 0 / 0.4);
	}
	.app:focus-visible .icon {
		outline: 2px solid var(--ink-gray-9);
		outline-offset: 3px;
	}
	/* While one is in focus, the others step back. */
	.cluster:has(.app:hover) .app:not(:hover) .icon {
		opacity: 0.45;
	}
	/* Names show only without hover (touch) or without motion. */
	.name {
		display: none;
		margin-top: 8px;
		font-size: 12px;
		white-space: nowrap;
		color: var(--ink-gray-7);
	}
	@media (hover: none) {
		.name {
			display: block;
		}
	}
	html:not([data-motion='on']) .name {
		display: block;
	}
	.info {
		position: absolute;
		top: calc(100% + 12px);
		display: flex;
		width: 230px;
		flex-direction: column;
		gap: 4px;
		padding: 12px 14px;
		border: 1px solid var(--outline-gray-2);
		border-radius: 12px;
		background: var(--surface-elevation-2, var(--surface-base));
		box-shadow: 0 16px 36px -14px rgb(0 0 0 / 0.35);
		text-align: left;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-6px) scale(0.97);
		transition:
			opacity 200ms var(--lab-ease),
			transform 400ms var(--lab-ease),
			visibility 0s 200ms;
	}
	.app[data-align='center'] .info {
		left: 50%;
		margin-left: -115px;
	}
	.app[data-align='start'] .info {
		left: 0;
	}
	.app[data-align='end'] .info {
		right: 0;
	}
	.app:hover .info,
	.app:focus-visible .info {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition:
			opacity 200ms var(--lab-ease) 60ms,
			transform 400ms var(--lab-ease) 60ms;
	}
	.info b {
		font-size: 14px;
		font-weight: 600;
		color: var(--ink-gray-9);
	}
	.info span {
		font-size: 13px;
		line-height: 1.5;
		color: var(--ink-gray-6);
	}
	.info em {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-top: 4px;
		font-size: 11px;
		font-style: normal;
		font-weight: 500;
		color: var(--ink-green-7);
	}
	/* Lower icons open their card above, so it stays inside the stage. */
	.app[data-open='up'] .info {
		top: auto;
		bottom: calc(100% + 12px);
		transform: translateY(6px) scale(0.97);
	}
	.app[data-open='up']:hover .info,
	.app[data-open='up']:focus-visible .info {
		transform: none;
	}
</style>

<script>
	import { motionAllowed } from '../../scripts/landing/motion';

	// The cluster leans a few pixels toward the pointer, and back when it leaves.
	document.querySelectorAll<HTMLElement>('[data-orbit]').forEach((orbit) => {
		if (!motionAllowed() || !matchMedia('(hover: hover)').matches) return;
		const cluster = orbit.querySelector<HTMLElement>('[data-cluster]')!;
		orbit.addEventListener('pointermove', (event) => {
			const box = orbit.getBoundingClientRect();
			const dx = (event.clientX - box.left) / box.width - 0.5;
			const dy = (event.clientY - box.top) / box.height - 0.5;
			cluster.style.transform = `translate(${dx * 14}px, ${dy * 10}px)`;
		});
		orbit.addEventListener('pointerleave', () => (cluster.style.transform = ''));
	});
</script>
