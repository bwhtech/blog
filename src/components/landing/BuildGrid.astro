	/* Entrances: starting states apply only when motion is on and the card has
	   not been seen yet. Adding `in` runs plain CSS transitions to the end state. */
	.spark-line { transition: stroke-dashoffset 1400ms var(--lab-ease) 150ms; }
	.spark-area { transition: opacity 800ms ease 700ms; }
	[data-rise] { transition: opacity 500ms var(--lab-ease) calc(150ms + var(--i) * 120ms), transform 500ms var(--lab-ease) calc(150ms + var(--i) * 120ms); }
	[data-grow] { transition: transform 800ms var(--lab-ease) calc(150ms + var(--i) * 80ms); }
	[data-fill] { transition: transform 1000ms var(--lab-ease) calc(200ms + var(--i) * 100ms); }
	[data-dot] { transition: opacity 400ms var(--lab-ease) calc(150ms + var(--i) * 12ms), transform 400ms var(--lab-ease) calc(150ms + var(--i) * 12ms); }
	html[data-motion='on'] .card:not(.in) [data-draw] { stroke-dasharray: 1; stroke-dashoffset: 1; }
	html[data-motion='on'] .card [data-draw] { stroke-dasharray: 1; }
	html[data-motion='on'] .card:not(.in) [data-fade] { opacity: 0; }
	html[data-motion='on'] .card:not(.in) [data-rise] { opacity: 0; transform: translateY(6px); }
	html[data-motion='on'] .card:not(.in) [data-grow] { transform: scaleY(0); }
	html[data-motion='on'] .card:not(.in) [data-fill] { transform: scaleX(0); }
	html[data-motion='on'] .card:not(.in) [data-dot] { opacity: 0; transform: scale(0.4); }
</style>

<script>
	import { inView } from 'motion';
	import { motionAllowed } from '../../scripts/landing/motion';

	document.querySelectorAll<HTMLElement>('[data-build]').forEach((grid) => {
		const cards = grid.querySelectorAll<HTMLElement>('.card');
		if (!motionAllowed()) {
			cards.forEach((card) => card.classList.add('in'));
			return;
		}
		cards.forEach((card) => {
			const stop = inView(card, () => {
				card.classList.add('in');
				stop();
			}, { amount: 0.15 });
		});

		// The form steps itself while it is on screen: Next is pressed, the
		// next step slides in, and after the last it saves and starts over.
		const wizard = grid.querySelector<HTMLElement>('[data-wizard]');
		if (!wizard) return;
		const next = wizard.querySelector<HTMLElement>('[data-next]')!;
		const count = wizard.querySelector<HTMLElement>('[data-count]')!;
		const HOLD = { 1: 1800, 2: 1800, 3: 2000, 4: 2400 } as Record<number, number>;
		let at = 1;
		let timer = 0;
		const go = (step: number) => {
			at = step;
			wizard.dataset.at = String(at);
			count.textContent = String(Math.min(at, 3));
			next.textContent = at === 3 ? 'Save' : 'Next';
		};
		const tick = () => {
			if (at < 4) {
				next.classList.add('press');
				window.setTimeout(() => next.classList.remove('press'), 160);
			}
			go(at === 4 ? 1 : at + 1);
			timer = window.setTimeout(tick, HOLD[at]);
		};
		inView(wizard, () => {
			timer = window.setTimeout(tick, HOLD[at]);
			return () => window.clearTimeout(timer);
		});
	});
</script>
