		color: var(--ink-amber-7);
	}
	.meter {
		height: 6px;
		overflow: hidden;
		border-radius: 999px;
		background: var(--surface-gray-3);
	}
	.meter span {
		display: block;
		width: calc(var(--w) * 100%);
		height: 100%;
		border-radius: inherit;
