---
/**
 * What we build, as a bento of small working previews: each card shows the
 * part of the system, not a description of it. Previews use the same sample
 * programme as the hero dashboard. Entrances are CSS transitions switched on
 * by an `in` class, so a preview can never be left hidden by a script; the
 * phone's form then steps through on its own while it is on screen.
 */
import Icon from './Icon.astro';

const VISITS = [38, 52, 47, 61, 44, 58, 66, 49, 72, 63, 81, 57];
const max = Math.max(...VISITS);
// Drawn at about the size it shows on desktop, so the stroke is barely stretched.
const pts = VISITS.map((v, i) => [(i / (VISITS.length - 1)) * 640, 80 - (v / max) * 66] as const);
const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = `${line} L640,84 L0,84 Z`;

const TIMELINE = [
	{ what: 'Follow-up done', when: '12 Mar', tone: 'ok' },
	{ what: 'Note added', when: '10 Feb', tone: 'info' },
	{ what: 'Documents checked', when: '9 Jan', tone: 'ok' },
	{ what: 'Case opened', when: '2 Dec', tone: 'muted' },
];
const REPORT = [
	{ label: 'Q1', value: 0.48 },
	{ label: 'Q2', value: 0.62 },
	{ label: 'Q3', value: 0.71 },
	{ label: 'Q4', value: 0.9 },
];
// P present, L leave, A absent. Ten working days for five staff.
const STAFF = [
	{ who: 'PK', days: 'PPPPPLPPPP' },
	{ who: 'RS', days: 'PPPAPPPPPP' },
	{ who: 'AN', days: 'PPPPPPPLLP' },
	{ who: 'MS', days: 'PPLPPPPPPP' },
	{ who: 'DK', days: 'PPPPPPAPPP' },
];
// Last six months, in and out, as a share of the largest month.
const CASH = [
	{ label: 'Oct', in: 0.62, out: 0.48 },
	{ label: 'Nov', in: 0.55, out: 0.52 },
	{ label: 'Dec', in: 0.9, out: 0.58 },
	{ label: 'Jan', in: 0.48, out: 0.6 },
	{ label: 'Feb', in: 0.7, out: 0.5 },
	{ label: 'Mar', in: 1, out: 0.64 },
];
const STOCK = [
	{ name: 'Rice', qty: '420 kg', level: 0.84 },
	{ name: 'Lentils', qty: '160 kg', level: 0.52 },
	{ name: 'Hygiene kits', qty: '38', level: 0.16, low: true },
];
---

<div class="bento" data-build>
	<!-- Dashboards -->
	<article class="card a">
		<header class="card-head">
			<span class="badge"><Icon name="chart-column" size={16} /></span>
			<div>
				<h3>MIS and dashboards</h3>
				<p>Live numbers for leadership, from the records your team already keeps.</p>
			</div>
		</header>
		<div class="preview">
			<div class="kpis">
				<div><span>Records</span><b>248</b></div>
				<div><span>Completed</span><b>91%</b></div>
				<div><span>Pending</span><b>23</b></div>
			</div>
			<svg class="spark" viewBox="0 0 640 84" preserveAspectRatio="none" aria-hidden="true">
				<path d={area} class="spark-area" data-fade />
				<path d={line} class="spark-line" pathLength="1" data-draw />
			</svg>
		</div>
	</article>

	<!-- Field app -->
	<article class="card b">
		<header class="card-head">
			<span class="badge"><Icon name="smartphone" size={16} /></span>
			<div>
				<h3>Forms</h3>
				<p>Short or multi-step, on any phone, saved straight into the system.</p>
			</div>
		</header>
		<div class="preview preview-phone">
			<div class="phone" data-wizard data-at="1" aria-hidden="true">
				<div class="phone-bar"><span>9:41</span><span class="notch"></span><Icon name="wifi" size={11} /></div>
				<div class="wiz-head">
					<p class="phone-title">New visit</p>
					<span class="wiz-count"><b data-count>1</b> of 3</span>
				</div>
				<div class="wiz-bars"><i></i><i></i><i></i></div>
				<div class="wiz-labels"><span>Person</span><span>Visit</span><span>Needs</span></div>
				<div class="wiz-body">
					<div class="panel" data-panel="1">
						<div class="field"><span>Beneficiary</span><b><Icon name="search" size={12} />Lakshmi Bai</b></div>
						<div class="field"><span>Village</span><b>Kondagaon</b></div>
						<div class="field"><span>People in household</span><b>5</b></div>
					</div>
					<div class="panel" data-panel="2">
						<div class="field">
							<span>Visited?</span>
							<div class="seg"><i class="on">Yes</i><i>No</i></div>
						</div>
						<div class="field"><span>Date</span><b>12 Mar 2026</b></div>
						<div class="field">
							<span>Support</span>
							<div class="opts"><i class="on">Food</i><i>Shelter</i><i>Health</i></div>
						</div>
					</div>
					<div class="panel" data-panel="3">
						<div class="field">
							<span>Needs</span>
							<ul class="checks">
								<li class="on"><i></i>Ration card renewed</li>
								<li><i></i>Referral to clinic</li>
								<li class="on"><i></i>Follow up in 30 days</li>
							</ul>
						</div>
						<div class="field"><span>Photo</span><b class="muted"><Icon name="camera" size={12} />1 photo attached</b></div>
					</div>
					<div class="panel done" data-panel="4">
						<span class="done-mark"><Icon name="check" size={22} strokeWidth={2.5} /></span>
						<b>Saved to the register</b>
						<span>Lakshmi Bai's record now shows this visit.</span>
					</div>
				</div>
				<div class="wiz-nav">
					<span class="ghost">Back</span>
					<span class="next" data-next>Next</span>
				</div>
			</div>
		</div>
	</article>

	<!-- Case management -->
	<article class="card c">
		<header class="card-head">
			<span class="badge"><Icon name="users" size={16} /></span>
			<div>
				<h3>Data entry and case management</h3>
				<p>One record for each person or case, with its whole history in one place.</p>
			</div>
		</header>
		<div class="preview">
			<div class="person">
				<span class="avatar">LB</span>
				<div><b>Lakshmi Bai</b><span>Kondagaon · Food</span></div>
				<span class="pill ok">Active</span>
			</div>
			<ol class="timeline">
				{TIMELINE.map((item) => (
					<li data-rise style={`--i:${TIMELINE.indexOf(item)}`}><i class={item.tone}></i><span>{item.what}</span><time>{item.when}</time></li>
				))}
			</ol>
		</div>
	</article>

	<!-- Reports -->
	<article class="card d">
		<header class="card-head">
			<span class="badge"><Icon name="file-text" size={16} /></span>
			<div>
				<h3>Reports</h3>
				<p>The reports your team and funders ask for, built from live data.</p>
			</div>
		</header>
		<div class="preview">
			<div class="doc">
				<div class="doc-head"><b>Records by quarter</b><span class="chip"><Icon name="download" size={11} />PDF</span></div>
				<div class="bars">
					{REPORT.map((bar) => (
						<div class="bar-col"><span class="bar" style={`--h:${bar.value};--i:${REPORT.indexOf(bar)}`} data-grow></span><em>{bar.label}</em></div>
					))}
				</div>
			</div>
		</div>
	</article>

	<!-- HR -->
	<article class="card e">
		<header class="card-head">
			<span class="badge"><Icon name="calendar-check" size={16} /></span>
			<div>
				<h3>People management</h3>
				<p>Attendance, leave and payroll for your team, on Frappe HR.</p>
			</div>
		</header>
		<div class="preview">
			<div class="attendance">
				{STAFF.map((row, r) => (
					<div class="att-row">
						<span class="att-who">{row.who}</span>
						{[...row.days].map((day, d) => <i class:list={['dot', day]} style={`--i:${r * 10 + d}`} data-dot></i>)}
					</div>
				))}
			</div>
			<div class="legend"><span><i class="dot P"></i>Present</span><span><i class="dot L"></i>Leave</span><span><i class="dot A"></i>Absent</span></div>
		</div>
	</article>

	<!-- Accounts and inventory -->
	<article class="card f">
		<header class="card-head">
			<span class="badge"><Icon name="package" size={16} /></span>
			<div>
				<h3>Accounts and inventory</h3>
				<p>Money in and out, and the stock in every store, on ERPNext.</p>
			</div>
		</header>
		<div class="preview">
			<div class="books">
				<div class="tile">
					<div class="tile-head"><span>Cash and bank</span><em><i class="key in"></i>In <i class="key out"></i>Out</em></div>
					<b class="big">₹12.6 L</b>
					<div class="flow">
						{CASH.map((month, m) => (
							<div class="flow-col">
								<span class="pair">
									<span class="bar-in" style={`--h:${month.in};--i:${m}`} data-grow></span>
									<span class="bar-out" style={`--h:${month.out};--i:${m}`} data-grow></span>
								</span>
								<em>{month.label}</em>
							</div>
						))}
					</div>
				</div>
				<div class="tile">
					<div class="tile-head"><span>Stock, main store</span></div>
					<ul class="stock">
						{STOCK.map((item, k) => (
							<li>
								<div class="stock-line">
									<span>{item.name}</span>
									{item.low ? <span class="pill low">Reorder</span> : <b>{item.qty}</b>}
								</div>
								<div class:list={['meter', item.low && 'meter-low']}><span style={`--w:${item.level};--i:${k}`} data-fill></span></div>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</article>
</div>

<style>
	.bento {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-template-areas:
			'a a b'
			'c d b'
			'e f f';
		gap: 12px;
	}
	.a { grid-area: a; }
	.b { grid-area: b; }
	.c { grid-area: c; }
	.d { grid-area: d; }
	.e { grid-area: e; }
	.f { grid-area: f; }
	@media (max-width: 1023px) {
		.bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-areas:
				'a a'
				'b c'
				'b d'
				'e f';
		}
	}
	@media (max-width: 639px) {
		.bento {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'a' 'b' 'c' 'd' 'e' 'f';
		}
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 18px;
		overflow: hidden;
		padding: 20px 20px 0;
		border: 1px solid var(--outline-gray-2);
		border-radius: 14px;
		background: var(--surface-base);
		transition:
			border-color 300ms var(--lab-ease),
			box-shadow 300ms var(--lab-ease);
	}
	.card:hover {
		border-color: var(--outline-gray-3);
		box-shadow: 0 12px 32px -18px rgb(0 0 0 / 0.25);
	}
	.card-head {
		display: flex;
		gap: 12px;
	}
	.badge {
		display: flex;
		width: 32px;
		height: 32px;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--outline-gray-2);
		border-radius: 9px;
		color: var(--ink-gray-7);
		transition:
			background-color 300ms var(--lab-ease),
			color 300ms var(--lab-ease),
			border-color 300ms var(--lab-ease);
	}
	.card:hover .badge {
		border-color: var(--ink-gray-9);
		background: var(--ink-gray-9);
		color: var(--surface-base);
	}
	.card-head h3 {
		font-size: 15px;
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink-gray-9);
	}
	.card-head p {
		margin-top: 3px;
		max-width: 44ch;
		font-size: 13px;
		line-height: 1.5;
		color: var(--ink-gray-6);
		text-wrap: pretty;
	}
	/* The preview sits on a tray that runs off the bottom of the card. */
	.preview {
		flex: 1;
		margin: 0 -1px;
		padding: 16px;
		border: 1px solid var(--outline-gray-1);
		border-bottom: 0;
		border-radius: 10px 10px 0 0;
		background: var(--surface-gray-1);
		font-size: 12px;
		color: var(--ink-gray-7);
	}

	/* A: dashboards */
	.kpis {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}
	.kpis div {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 10px 12px;
		border: 1px solid var(--outline-gray-1);
		border-radius: 8px;
		background: var(--surface-base);
	}
	.kpis span {
		font-size: 11px;
		color: var(--ink-gray-5);
	}
	.kpis b {
		font-size: 20px;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink-gray-9);
		font-variant-numeric: tabular-nums;
	}
	.spark {
		display: block;
		width: 100%;
		height: 84px;
		margin-top: 12px;
		overflow: visible;
	}
	.spark-line {
		fill: none;
		stroke: var(--viz-blue);
		stroke-width: 2;
		stroke-linejoin: round;
	}
	.spark-area {
		fill: var(--viz-blue-soft);
		opacity: 0.55;
	}

	/* B: phone, a three-step form that steps itself */
	.preview-phone {
		display: flex;
		justify-content: center;
		padding: 16px 14px 0;
	}
	/* As wide as the tray allows, up to a real phone's proportions. */
	.phone {
		position: relative;
		display: flex;
		width: 100%;
		max-width: 300px;
		min-height: 440px;
		flex-direction: column;
		padding: 10px 14px 16px;
		border: 6px solid var(--ink-gray-9);
		border-bottom: 0;
		border-radius: 28px 28px 0 0;
		background: var(--surface-base);
	}
	.phone-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 10px;
		font-weight: 600;
		color: var(--ink-gray-8);
	}
	.notch {
		width: 54px;
		height: 14px;
		border-radius: 999px;
		background: var(--ink-gray-9);
	}
	.wiz-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-top: 12px;
	}
	.phone-title {
		font-size: 15px;
		font-weight: 600;
		color: var(--ink-gray-9);
	}
	.wiz-count {
		font-size: 10px;
		color: var(--ink-gray-5);
		font-variant-numeric: tabular-nums;
	}
	.wiz-count b {
		font-weight: 600;
		color: var(--ink-gray-8);
	}
	.wiz-bars {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 4px;
		margin-top: 10px;
	}
	.wiz-bars i {
		position: relative;
		height: 3px;
		overflow: hidden;
		border-radius: 999px;
		background: var(--surface-gray-3);
	}
	.wiz-bars i::after {
		position: absolute;
		inset: 0;
		background: var(--ink-gray-9);
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 500ms var(--lab-ease);
	}
	[data-at='1'] .wiz-bars i:nth-child(-n + 1)::after,
	[data-at='2'] .wiz-bars i:nth-child(-n + 2)::after,
	[data-at='3'] .wiz-bars i::after,
	[data-at='4'] .wiz-bars i::after {
		transform: none;
	}
	[data-at='4'] .wiz-bars i::after {
		background: var(--viz-visited);
	}
	.wiz-labels {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 4px;
		margin-top: 5px;
		font-size: 9.5px;
		color: var(--ink-gray-4);
	}
	[data-at='1'] .wiz-labels span:nth-child(1),
	[data-at='2'] .wiz-labels span:nth-child(2),
	[data-at='3'] .wiz-labels span:nth-child(3) {
		font-weight: 600;
		color: var(--ink-gray-8);
	}
	/* Panels share one cell; the current one slides in, the last one out. */
	.wiz-body {
		display: grid;
		flex: 1;
		margin-top: 14px;
	}
	.panel {
		display: flex;
		grid-area: 1 / 1;
		flex-direction: column;
		gap: 10px;
		opacity: 0;
		visibility: hidden;
		transform: translateX(16px);
		transition:
			opacity 300ms var(--lab-ease),
			transform 450ms var(--lab-ease),
			visibility 0s 450ms;
	}
	[data-at='1'] [data-panel='1'],
	[data-at='2'] [data-panel='2'],
	[data-at='3'] [data-panel='3'],
	[data-at='4'] [data-panel='4'] {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition:
			opacity 300ms var(--lab-ease) 120ms,
			transform 450ms var(--lab-ease) 120ms;
	}
	[data-at='2'] [data-panel='1'],
	[data-at='3'] [data-panel='1'],
	[data-at='3'] [data-panel='2'] {
		transform: translateX(-16px);
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.field > span {
		font-size: 10px;
		color: var(--ink-gray-5);
	}
	.field b {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 7px 9px;
		border-radius: 7px;
		background: var(--surface-gray-2);
		font-size: 12px;
		font-weight: 500;
		color: var(--ink-gray-9);
	}
	.field b :global(svg) {
		color: var(--ink-gray-5);
	}
	.field b.muted {
		font-weight: 400;
		color: var(--ink-gray-7);
	}
	.seg {
		display: grid;
		grid-template-columns: 1fr 1fr;
		padding: 2px;
		border-radius: 7px;
		background: var(--surface-gray-2);
	}
	.seg i,
	.opts i {
		padding: 5px;
		border-radius: 5px;
		font-size: 11.5px;
		font-style: normal;
		text-align: center;
		color: var(--ink-gray-6);
	}
	.seg i.on {
		background: var(--surface-base);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
		font-weight: 500;
		color: var(--ink-gray-9);
	}
	.opts {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
	}
	.opts i {
		padding: 4px 9px;
		border: 1px solid var(--outline-gray-2);
		border-radius: 999px;
	}
	.opts i.on {
		border-color: var(--ink-gray-9);
		background: var(--ink-gray-9);
		color: var(--surface-base);
	}
	.checks {
		display: flex;
		flex-direction: column;
		gap: 7px;
		font-size: 12px;
		color: var(--ink-gray-8);
	}
	.checks li {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.checks i {
		position: relative;
		width: 14px;
		height: 14px;
		flex-shrink: 0;
		border: 1.5px solid var(--outline-gray-4);
		border-radius: 4px;
	}
	.checks li.on i {
		border-color: var(--ink-gray-9);
		background: var(--ink-gray-9);
	}
	.checks li.on i::after {
		position: absolute;
		top: 1px;
		left: 4px;
		width: 3.5px;
		height: 7px;
		border: solid var(--surface-base);
		border-width: 0 1.6px 1.6px 0;
		content: '';
		transform: rotate(45deg);
	}
	.done {
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding-bottom: 24px;
		text-align: center;
	}
	.done-mark {
		display: flex;
		width: 48px;
		height: 48px;
		align-items: center;
		justify-content: center;
		margin-bottom: 6px;
		border-radius: 999px;
		background: var(--viz-visited);
		color: #fff;
		transform: scale(0.6);
		transition: transform 600ms cubic-bezier(0.34, 1.4, 0.64, 1) 200ms;
	}
	[data-at='4'] .done-mark {
		transform: none;
	}
	.done b {
		font-size: 13px;
		font-weight: 600;
		color: var(--ink-gray-9);
	}
	.done > span:last-child {
		max-width: 22ch;
		font-size: 11px;
		line-height: 1.45;
		color: var(--ink-gray-6);
	}
	.wiz-nav {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: 6px;
		margin-top: 14px;
		transition: opacity 300ms var(--lab-ease);
	}
	[data-at='4'] .wiz-nav {
		opacity: 0;
	}
	.wiz-nav span {
		padding: 8px;
		border-radius: 8px;
		font-size: 12px;
		font-weight: 500;
		text-align: center;
	}
	.ghost {
		background: var(--surface-gray-2);
		color: var(--ink-gray-7);
	}
	.next {
