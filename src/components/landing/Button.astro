---
/**
 * Buttons for the landing pages, drawn with frappe-ui tokens. A link when
 * `href` is set, a <button> otherwise.
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'solid' | 'subtle' | 'outline' | 'ghost' | 'violet';
type Size = 'sm' | 'md' | 'lg';

type Props = {
	variant?: Variant;
	size?: Size;
	href?: string;
	class?: string;
} & HTMLAttributes<'button'> &
	Omit<HTMLAttributes<'a'>, 'type'>;

const { variant = 'subtle', size = 'md', href, class: className, ...rest } = Astro.props;

const VARIANTS: Record<Variant, string> = {
	primary: 'bg-surface-blue-9 text-ink-base hover:bg-surface-blue-10 active:opacity-90',
	violet: 'bg-surface-violet-9 text-ink-base hover:bg-surface-violet-10 active:opacity-90',
	solid: 'bg-surface-gray-10 text-ink-base hover:bg-surface-gray-9 active:bg-surface-gray-8',
	subtle: 'bg-surface-gray-2 text-ink-gray-8 hover:bg-surface-gray-3 active:bg-surface-gray-4',
	outline:
		'border border-outline-gray-2 bg-surface-base text-ink-gray-8 hover:border-outline-gray-3 hover:bg-surface-gray-1',
	ghost: 'text-ink-gray-7 hover:bg-surface-gray-2 hover:text-ink-gray-9',
};

const SIZES: Record<Size, string> = {
	sm: 'h-7 gap-1 rounded-4 px-2.5 text-sm',
	md: 'h-8 gap-1.5 rounded-4 px-3 text-base-medium',
	lg: 'h-10 gap-2 rounded-5 px-4 text-lg-medium',
};

const classes = [
	'inline-flex shrink-0 select-none items-center justify-center whitespace-nowrap no-underline transition-colors duration-150 disabled:pointer-events-none disabled:opacity-50',
	VARIANTS[variant],
	SIZES[size],
	className,
];
---

{
	href ? (
		<a href={href} class:list={classes} {...rest}>
			<slot />
		</a>
	) : (
		<button type="button" class:list={classes} {...rest}>
			<slot />
		</button>
	)
}
