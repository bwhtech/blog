---
/**
 * A Lucide icon, inlined at build time. lucide-static ships with frappe-ui,
 * so these are the same glyphs the frappe-ui components draw.
 */
import nodes from 'lucide-static/icon-nodes.json';

interface Props {
	name: string;
	size?: number;
	class?: string;
	strokeWidth?: number;
}

const { name, size = 16, class: className, strokeWidth = 1.75 } = Astro.props;
const icon = (nodes as Record<string, [string, Record<string, string>][]>)[name];
if (!icon) throw new Error(`Unknown Lucide icon: ${name}`);

const escape = (value: string) => value.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
const inner = icon
	.map(([tag, attrs]) => {
		const attributes = Object.entries(attrs)
			.map(([key, value]) => `${key}="${escape(String(value))}"`)
			.join(' ');
		return `<${tag} ${attributes} />`;
	})
	.join('');
---

<svg
	class:list={['shrink-0', className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={inner}
/>
