---
/** The favicon mark, drawn in theme colours so it flips with dark mode. */
interface Props {
	size?: number;
	class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg
	class:list={['shrink-0', className]}
	width={size}
	height={size}
	viewBox="0 0 32 32"
	aria-hidden="true"
>
	<rect width="32" height="32" rx="8" style="fill: var(--ink-gray-9)"></rect>
	<path
		style="fill: var(--surface-base)"
		d="M8 8h7.5c3.3 0 5.5 1.6 5.5 4.4 0 1.6-.8 2.8-2.1 3.5 1.8.6 2.8 1.9 2.8 3.8 0 3-2.4 4.8-6 4.8H8V8Zm7.1 6.5c1.5 0 2.4-.6 2.4-1.8 0-1.1-.9-1.7-2.4-1.7h-3.6v3.5h3.6Zm.4 7c1.7 0 2.7-.7 2.7-2 0-1.3-1-2-2.7-2h-4v4h4Z"
	></path>
</svg>
