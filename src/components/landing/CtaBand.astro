---
/**
 * The closing ask: a heading, a line and one button, on a dark band in both
 * themes. The styling does the work: a dot grid that fades out toward the
 * edges, a slow glow behind the heading, a lit top edge, and a button with a
 * sheen on hover. The faces are the team.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import { CTA } from '../../data/landing';
import Icon from './Icon.astro';

const FIRST = 'hussain-nagaria';
const team = (await getCollection('authors')).sort(
	(a, b) => Number(b.id === FIRST) - Number(a.id === FIRST) || a.data.name.localeCompare(b.data.name),
);
---

<section id="tell-us" aria-labelledby="tell-us-title" class="band scroll-mt-24">
	<span class="glow" aria-hidden="true"></span>
	<span class="grid" aria-hidden="true"></span>
	<div class="inner">
		<h2 id="tell-us-title">Tell us the problem.</h2>
		<p>We listen first, then work it out with you.</p>
		<a href={CTA.meetHref} class="go">
			<span>{CTA.secondary}</span>
			<Icon name="arrow-right" size={16} />
		</a>
		<span class="faces">
			<span class="stack" aria-hidden="true">
				{team.slice(0, 5).map((person) => (
					<Image src={person.data.avatar} alt="" width={64} height={64} class="face" />
				))}
			</span>
			You talk to the team that builds it.
		</span>
	</div>
</section>

<style>
	.band {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 88px 24px 72px;
		border-radius: 24px;
		background: #111;
		color: #fafafa;
		text-align: center;
		/* A lit top edge that fades out at the sides, over a faint full outline. */
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.12),
			0 0 0 1px rgb(255 255 255 / 0.06);
	}
	.band::before {
		position: absolute;
		top: 0;
		left: 15%;
		right: 15%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.55), transparent);
		content: '';
	}
	@media (max-width: 639px) {
		.band {
			padding: 64px 20px 56px;
		}
	}
	/* Dots, strongest in the middle and gone at the edges. */
	.grid {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.13) 1px, transparent 0) 0 0 / 22px 22px;
		-webkit-mask: radial-gradient(75% 90% at 50% 35%, #000, transparent 70%);
		mask: radial-gradient(75% 90% at 50% 35%, #000, transparent 70%);
	}
	/* A soft light behind the heading that drifts slowly. */
	.glow {
		position: absolute;
		top: -40%;
		left: 50%;
		z-index: -1;
		width: 900px;
		height: 560px;
		margin-left: -450px;
		/* Each light fades to nothing well inside the box, so no edge shows. */
		background:
			radial-gradient(30% 40% at 38% 50%, rgb(34 131 195 / 0.34), transparent 100%),
			radial-gradient(30% 40% at 62% 50%, rgb(40 158 96 / 0.26), transparent 100%);
		filter: blur(40px);
	}
	html[data-motion='on'] .glow {
		animation: drift 14s ease-in-out infinite alternate;
	}
	@keyframes drift {
		to {
			transform: translateX(60px) scale(1.08);
		}
	}
	.inner {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	h2 {
		max-width: 16ch;
		font-size: 48px;
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.035em;
		/* A touch of shading, top to bottom, so the white is not flat. */
		background: linear-gradient(180deg, #fff 30%, rgb(255 255 255 / 0.72));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		text-wrap: balance;
	}
	@media (max-width: 639px) {
		h2 {
			font-size: 34px;
		}
	}
	.inner > p {
		margin-top: 14px;
		font-size: 18px;
		line-height: 1.5;
		color: rgb(255 255 255 / 0.6);
	}
	.go {
		position: relative;
		display: inline-flex;
		height: 46px;
		align-items: center;
		gap: 8px;
		overflow: hidden;
		margin-top: 32px;
		padding: 0 20px;
		border-radius: 12px;
		background: #fff;
		font-size: 16px;
		font-weight: 500;
		color: #111;
		text-decoration: none;
		box-shadow:
			0 1px 0 rgb(255 255 255 / 0.4) inset,
			0 8px 24px -8px rgb(255 255 255 / 0.25);
		transition:
			transform 200ms var(--lab-ease),
			box-shadow 300ms var(--lab-ease);
	}
	/* The sheen: a light band that crosses the button on hover. */
	.go::after {
		position: absolute;
		inset: 0;
		background: linear-gradient(105deg, transparent 35%, rgb(0 0 0 / 0.07) 50%, transparent 65%);
		content: '';
		transform: translateX(-100%);
	}
	.go:hover::after {
		transform: translateX(100%);
		transition: transform 700ms var(--lab-ease);
	}
	.go :global(svg) {
		transition: transform 300ms var(--lab-ease);
	}
	.go:hover {
		box-shadow:
			0 1px 0 rgb(255 255 255 / 0.4) inset,
			0 12px 32px -8px rgb(255 255 255 / 0.4);
	}
	.go:hover :global(svg) {
		transform: translateX(3px);
	}
	.go:active {
		transform: scale(0.97);
	}
	.go:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}
	.faces {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 28px;
		font-size: 13px;
		color: rgb(255 255 255 / 0.55);
	}
	.stack {
		display: flex;
	}
	@media (max-width: 639px) {
		.faces {
			flex-direction: column;
		}
	}
	.stack :global(.face) {
		width: 26px;
		height: 26px;
		border: 2px solid #111;
		border-radius: 999px;
		object-fit: cover;
		filter: grayscale(1);
	}
	.stack :global(.face + .face) {
		margin-left: -8px;
	}
</style>
