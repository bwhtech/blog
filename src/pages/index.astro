<script>
	import { createDashboard } from '../scripts/landing/dashboard';
	import { boot, motionAllowed } from '../scripts/landing/motion';

	boot();

	const scene = document.querySelector<HTMLElement>('[data-scene]')!;
	const stage = scene.querySelector<HTMLElement>('[data-stage]')!;
	const header = document.querySelector<HTMLElement>('[data-header]')!;
	const caption = stage.querySelector<HTMLElement>('[data-caption]')!;
	const dots = stage.querySelectorAll<HTMLElement>('[data-dot]');
	const sheetLayer = stage.querySelector<HTMLElement>('[data-sheet-layer]')!;
	const dashLayer = stage.querySelector<HTMLElement>('[data-dash]')!;
	const chip = stage.querySelector<HTMLElement>('[data-sources]')!;
	const chipText = chip.querySelector<HTMLElement>('[data-sources-text]')!;
	const chipIcon = chip.querySelector('svg') ?? chip;
	const chipHome = stage.querySelector<HTMLElement>('[data-chip-home]')!;
	const chipDock = stage.querySelector<HTMLElement>('[data-chip-dock]')!;
	const wipe = stage.querySelector<HTMLElement>('[data-wipe]')!;
	const mess = [...stage.querySelectorAll<HTMLElement>('[data-mess]')];
	const flyers = [...stage.querySelectorAll<HTMLElement>('[data-fly]')];
	const hdrA = [...header.querySelectorAll<HTMLElement>('[data-hdr-a]')];
	const hdrB = [...header.querySelectorAll<HTMLElement>('[data-hdr-b]')];
	const dup = stage.querySelector<HTMLElement>('[data-dup]');
	const afterDup = [...stage.querySelectorAll<HTMLElement>('[data-after-dup]')];

	// The dashboard is drawn now but stays shut and unreachable until it is live.
	dashLayer.inert = true;
	const dashboard = createDashboard(dashLayer);
	chip.hidden = false;
	chip.style.opacity = '0';

	const CAPTIONS = [
		'Sound familiar? Four ways to write “yes”, one person twice, and a total nobody trusts.',
		'We listen first. Then every sheet, form and chat goes into one place.',
		'One record per person, and the dashboard builds itself from it.',
		'It is live: try the filters. Then we train your team to run it.',
	];
	const LIVE_AT = 0.84;

	const clamp = (value: number) => Math.min(1, Math.max(0, value));
	const seg = (p: number, from: number, to: number) => clamp((p - from) / (to - from));
	const ease = (t: number) => 1 - Math.pow(1 - t, 3);
	const smooth = (t: number) => t * t * (3 - 2 * t);
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

	// Positions inside the stage: where the chip appears, where it docks in the
	// dashboard, and how far each card travels to reach it.
	let geo = { home: { x: 0, y: 0 }, dock: { x: 0, y: 0 }, targets: [] as { dx: number; dy: number }[] };
	function measure() {
		flyers.forEach((el) => (el.style.transform = ''));
		const box = stage.getBoundingClientRect();
		const width = chip.offsetWidth;
		chipDock.style.width = `${width}px`;
		const home = chipHome.getBoundingClientRect();
		const dock = chipDock.getBoundingClientRect();
		geo.home = { x: home.right - box.left - width, y: home.top - box.top };
		geo.dock = { x: dock.left - box.left, y: dock.top - box.top };
		const icon = { x: box.left + geo.home.x + (chipIcon as HTMLElement | SVGElement).getBoundingClientRect().left - chip.getBoundingClientRect().left + 6, y: box.top + geo.home.y + 14 };
		geo.targets = flyers.map((el) => {
			const card = el.getBoundingClientRect();
			// Phones shrink the cards with `scale`, which also shrinks the travel.
			const scale = Number.parseFloat(getComputedStyle(el).scale) || 1;
			return {
				dx: (icon.x - (card.left + card.width / 2)) / scale,
				dy: (icon.y - (card.top + card.height / 2)) / scale,
			};
		});
	}

	// Which chrome fits what is on screen: the sheet's, the dashboard's, or,
	// once most of the scene has scrolled away, the plain site header.
	const page = document.querySelector<HTMLElement>('[data-sheet-page]')!;
	const switcher = document.querySelector<HTMLElement>('.lab-switcher');
	if (switcher) switcher.style.transition = 'bottom 450ms cubic-bezier(0.16, 1, 0.3, 1)';
	let sceneP = 0;
	function updateChrome() {
		const past = scene.getBoundingClientRect().bottom < window.innerHeight * 0.5;
		const next = past ? 'site' : sceneP < 0.56 ? 'sheet' : 'app';
		if (page.dataset.chrome === next) return;
		page.dataset.chrome = next;
		if (switcher) switcher.style.bottom = `${next === 'sheet' ? 48 : 12}px`;
	}
	window.addEventListener('scroll', updateChrome, { passive: true });
	window.addEventListener('resize', updateChrome);
	updateChrome();

	let step = -1;
	let live = false;
	function render(p: number) {
		sceneP = p;
		updateChrome();
		mess.forEach((el) => (el.style.opacity = String(1 - seg(p, 0.14, 0.24))));

		// The form, the chat and the script turn up, then each flies into the chip
		// and is gone before it arrives. The count rises as each one lands.
		let merged = 0;
		flyers.forEach((el, i) => {
			const appear = ease(seg(p, 0.03 + i * 0.025, 0.1 + i * 0.025));
			const t = ease(seg(p, 0.15 + i * 0.06, 0.33 + i * 0.06));
			const fade = clamp((t - 0.5) / 0.4);
			const rot = Number(el.dataset.rot ?? 0) * (1 - t);
			const { dx, dy } = geo.targets[i] ?? { dx: 0, dy: 0 };
			el.style.transform = `translate(${dx * t}px, ${dy * t + (1 - appear) * 10}px) rotate(${rot}deg) scale(${(1 - 0.7 * t) * (0.96 + 0.04 * appear)})`;
			el.style.opacity = String(appear * (1 - fade));
			el.style.filter = fade > 0 ? `blur(${fade * 6}px)` : '';
			if (fade >= 1) merged += 1;
		});
		chipText.textContent = `Sources: ${merged} merged`;

		// The chip appears beside the total, then rides the wipe into the header.
		const chipIn = ease(seg(p, 0.1, 0.15));
		const ride = smooth(seg(p, 0.5, 0.64));
		chip.style.opacity = String(chipIn);
		chip.style.transform = `translate(${lerp(geo.home.x, geo.dock.x, ride)}px, ${lerp(geo.home.y, geo.dock.y, ride)}px) scale(${0.92 + 0.08 * chipIn})`;

		const rowHeight = dup?.offsetHeight || 30;
		if (dup) {
			const d = ease(seg(p, 0.36, 0.44));
			dup.style.opacity = String(1 - d);
			dup.style.transform = `scaleY(${1 - d})`;
			dup.style.transformOrigin = 'top';
			afterDup.forEach((el) => (el.style.translate = `0 ${-rowHeight * d}px`));
		}

		// One straight wipe across the whole stage, with the line as its front.
		const w = smooth(seg(p, 0.46, 0.64));
		sheetLayer.style.clipPath = w > 0 ? `inset(0 0 0 ${w * 100}%)` : '';
		dashLayer.style.clipPath = w >= 1 ? 'none' : `inset(0 ${(1 - w) * 100}% 0 0)`;
		wipe.style.left = `${w * 100}%`;
		wipe.style.opacity = w > 0 && w < 1 ? '1' : '0';
		hdrA.forEach((el) => (el.style.opacity = String(1 - ease(seg(p, 0.5, 0.62)))));
		hdrB.forEach((el) => (el.style.opacity = String(ease(seg(p, 0.56, 0.68)))));

		dashboard.progress(seg(p, 0.64, LIVE_AT));
		if (p >= LIVE_AT !== live) {
			live = p >= LIVE_AT;
			dashboard.setLive(live);
		}

		const next = p < 0.12 ? 0 : p < 0.46 ? 1 : p < LIVE_AT ? 2 : 3;
		if (next !== step) {
			step = next;
			caption.textContent = CAPTIONS[step];
			dots.forEach((dot, i) => {
				dot.classList.toggle('bg-surface-blue-8', i <= step);
				dot.classList.toggle('bg-surface-gray-4', i > step);
			});
		}
	}

	if (motionAllowed()) {
		let frame = 0;
		// Progress is how far the scene has scrolled under the header, over the
		// distance the pinned stage can travel inside it.
		const update = () => {
			frame = 0;
			const travel = scene.offsetHeight - stage.offsetHeight;
			// 77px: the header at full height, the same in every chrome state.
			render(clamp((77 - scene.getBoundingClientRect().top) / travel));
		};
		const queue = () => (frame ||= requestAnimationFrame(update));
		const remeasure = () => {
			measure();
			queue();
		};
		window.addEventListener('scroll', queue, { passive: true });
		window.addEventListener('resize', remeasure);
		document.fonts?.ready.then(remeasure);
		measure();
		update();
	} else {
		// Reduced motion: no scroll scene. A Before / After toggle instead, and
		// After is the live dashboard.
		const toggle = stage.querySelector<HTMLElement>('[data-toggle]')!;
		toggle.hidden = false;
		let shown = 0;
		const show = (which: number) => {
			shown = which;
			render(which ? 1 : 0.145);
			toggle.querySelectorAll('button').forEach((button) => button.setAttribute('aria-pressed', String(Number(button.dataset.show) === which)));
		};
		toggle.querySelectorAll<HTMLButtonElement>('button').forEach((button) =>
			button.addEventListener('click', () => show(Number(button.dataset.show))),
		);
		window.addEventListener('resize', () => {
			measure();
			show(shown);
		});
		measure();
		show(0);
	}

	// The formula bar reads whatever cell you point at.
	const nameBox = header.querySelector('[data-name-box]')!;
	const formula = header.querySelector('[data-formula]')!;
	const DEFAULT = { ref: nameBox.textContent ?? 'A1', formula: formula.textContent ?? '' };
	stage.querySelectorAll<HTMLElement>('[data-cell][data-ref]').forEach((cell) => {
		cell.addEventListener('pointerenter', () => {
			nameBox.textContent = cell.dataset.ref ?? '';
			formula.textContent = cell.dataset.formula ?? '';
		});
		cell.addEventListener('pointerleave', () => {
			nameBox.textContent = DEFAULT.ref;
			formula.textContent = DEFAULT.formula;
		});
	});

	// Tabs, in the sheet bar and the site header, follow the section in view.
	const TABS_IDS = [...new Set([...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')].map((tab) => `#${tab.dataset.tab}`))].join(', ');
	const tabs = document.querySelectorAll<HTMLAnchorElement>('[data-tab]');
	const observer = new IntersectionObserver(
		(entries) =>
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				tabs.forEach((tab) => tab.setAttribute('aria-current', String(tab.dataset.tab === entry.target.id)));
			}),
		{ rootMargin: '-35% 0px -55% 0px' },
	);
	document.querySelectorAll(TABS_IDS).forEach((el) => observer.observe(el));
</script>
