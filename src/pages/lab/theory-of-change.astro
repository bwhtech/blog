</style>

<script>
	import { animate, stagger } from 'motion';
	import { boot, EASE_OUT, motionAllowed } from '../../scripts/landing/motion';

	boot();

	// The focal moment: the chain draws itself left to right, then a pulse
	// runs along it once, from the problem to the impact.
	const chain = document.querySelector<HTMLElement>('[data-chain]');
	if (chain && motionAllowed()) {
		const nodes = chain.querySelectorAll<HTMLElement>('[data-node]');
		const lines = chain.querySelectorAll<SVGPathElement>('.chain-line, .chain-head');
		const pulses = [...chain.querySelectorAll<SVGCircleElement>('.chain-pulse')];
		const light = (index: number, at: number) =>
			setTimeout(() => {
				nodes[index]?.setAttribute('data-lit', '');
				setTimeout(() => nodes[index]?.removeAttribute('data-lit'), 520);
			}, at * 1000);
		animate(lines, { strokeDashoffset: [1, 0] }, { duration: 0.35, ease: EASE_OUT, delay: stagger(0.055, { startDelay: 0.3 }) });
		light(0, 1.0);
		pulses.forEach((pulse, index) => {
			const start = 1.2 + index * 0.42;
			animate(pulse, { opacity: [0, 1, 1, 0], cx: [1, 34] }, { duration: 0.42, ease: 'easeInOut', delay: start });
			light(index + 1, start + 0.38);
		});
	}

	// The walk: scrolling down moves the track sideways.
	const walk = document.querySelector<HTMLElement>('[data-walk]')!;
	const stage = walk.querySelector<HTMLElement>('[data-walk-stage]')!;
	const track = walk.querySelector<HTMLElement>('[data-track]')!;
	const panels = [...walk.querySelectorAll<HTMLElement>('[data-panel]')];
	const bar = walk.querySelector<HTMLElement>('[data-walk-bar]')!;
	const minis = document.querySelectorAll<HTMLAnchorElement>('[data-mini]');
	const narrow = matchMedia('(max-width: 767px)');

	const markStage = (id: string | undefined) =>
		minis.forEach((mini) => mini.setAttribute('aria-current', String(mini.dataset.mini === id)));

	let pinned = false;
	function layout() {
		pinned = motionAllowed() && !narrow.matches;
		walk.toggleAttribute('data-stacked', !pinned);
		if (!pinned) track.style.transform = '';
		update();
	}

	function update() {
		if (!pinned) return;
		const travel = walk.offsetHeight - stage.offsetHeight;
		const progress = Math.min(1, Math.max(0, -walk.getBoundingClientRect().top / travel));
		const distance = track.scrollWidth - window.innerWidth;
		track.style.transform = `translateX(${-progress * distance}px)`;
		bar.style.transform = `scaleX(${progress})`;
		const center = window.innerWidth / 2;
		let active: HTMLElement | undefined;
		panels.forEach((panel) => {
			const box = panel.getBoundingClientRect();
			const near = Math.abs(box.left + box.width / 2 - center) < box.width / 2 + 16;
			panel.style.opacity = near ? '1' : '0.45';
			if (near && !active) active = panel;
		});
		// The stage takes on the colour of the stage you are reading.
		if (active) stage.style.backgroundColor = `var(--surface-${active.dataset.tone}-1)`;
		if (walk.getBoundingClientRect().top <= 56 && walk.getBoundingClientRect().bottom > window.innerHeight / 2) {
			markStage(active?.dataset.stageId);
		} else {
			markStage(undefined);
		}
	}

	let frame = 0;
	window.addEventListener('scroll', () => (frame ||= requestAnimationFrame(() => ((frame = 0), update()))), { passive: true });
	window.addEventListener('resize', layout);
	narrow.addEventListener('change', layout);
	layout();

	const scrollToPanel = (panel: HTMLElement, smooth: boolean) => {
		const index = panels.indexOf(panel);
		const travel = walk.offsetHeight - stage.offsetHeight;
		const distance = track.scrollWidth - window.innerWidth;
		const step = (panel.offsetWidth + parseFloat(getComputedStyle(track).gap)) / distance;
		window.scrollTo({ top: walk.offsetTop + Math.min(1, index * step) * travel, behavior: smooth ? 'smooth' : 'auto' });
	};
	panels.forEach((panel) =>
		panel.addEventListener('focusin', () => {
			if (!pinned) return;
			stage.scrollLeft = 0;
			scrollToPanel(panel, false);
		}),
	);

	// Jumping to a stage from the chain or the bar lands on that panel.
	document.querySelectorAll<HTMLAnchorElement>('a[href^="#stage-"]').forEach((link) =>
		link.addEventListener('click', (event) => {
			const panel = document.querySelector<HTMLElement>(link.getAttribute('href')!);
			if (!panel || !pinned) return;
			event.preventDefault();
			scrollToPanel(panel, motionAllowed());
		}),
	);
</script>
