		stroke-width: 1.75;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}
	.chain-pulse {
		fill: var(--line);
		opacity: 0;
	}
	@media (max-width: 1023px) {
		.chain {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.chain-node:nth-child(3) .chain-link {
			display: none;
		}
	}
	@media (max-width: 639px) {
		.chain {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.75rem;
		}
		.chain-node {
			min-height: 0;
		}
		.chain-node .chain-link,
		.chain-node:nth-child(3) .chain-link {
			display: block;
			top: auto;
			bottom: -1.6rem;
			right: auto;
			left: 1.25rem;
			transform: rotate(90deg);
			transform-origin: left center;
			width: 1.5rem;
		}
	}
	.chain-band {
		transition: background-color 220ms var(--lab-ease);
	}
	.chain-node[data-lit] .chain-band {
		background-color: var(--band-lit);
	}
	html[data-motion='on'] .chain-line,
	html[data-motion='on'] .chain-head {
		stroke-dashoffset: 1;
	}

	/* The walk: a horizontal track inside a tall section, pinned under the bar. */
	.walk {
		--panel: min(56rem, 82vw);
		--gap: 2rem;
		height: 560vh;
	}
	.walk-stage {
		position: sticky;
		top: 56px;
		height: calc(100vh - 56px);
		height: calc(100dvh - 56px);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background: var(--surface-gray-1);
		border-block: 1px solid var(--outline-gray-1);
		transition: background-color 500ms var(--lab-ease);
	}
	.walk-track {
		display: flex;
		gap: var(--gap);
		padding-inline: calc((100vw - var(--panel)) / 2);
		will-change: transform;
	}
	.panel {
		flex: 0 0 var(--panel);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-height: calc(100vh - 140px);
		overflow: auto;
		padding: 2rem;
		border-radius: 12px;
		border: 1px solid var(--outline-gray-1);
		background: var(--surface-base);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 32px rgb(0 0 0 / 0.05);
		transition: opacity 300ms var(--lab-ease);
		scroll-margin-top: 80px;
	}
	.panel[data-tone='amber'] { --panel-tint: var(--surface-amber-1); }
	.panel[data-tone='gray'] { --panel-tint: var(--surface-gray-1); }
	.panel[data-tone='blue'] { --panel-tint: var(--surface-blue-1); }
	.panel[data-tone='cyan'] { --panel-tint: var(--surface-cyan-1); }
	.panel[data-tone='violet'] { --panel-tint: var(--surface-violet-1); }
	.panel[data-tone='pink'] { --panel-tint: var(--surface-pink-1); }
	.panel-split {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: 2rem;
		align-items: start;
	}
	.panel-head {
		display: flex;
		align-items: baseline;
		gap: 1rem;
	}
	.panel-stage {
		display: inline-flex;
		flex-shrink: 0;
