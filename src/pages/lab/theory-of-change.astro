		border-radius: 999px;
		background: var(--surface-gray-3);
		transform: translateX(-50%);
		overflow: hidden;
	}
	.walk-progress-bar {
		display: block;
		height: 100%;
		width: 100%;
		background: var(--surface-gray-10);
		transform-origin: left;
		transform: scaleX(0);
	}

	/* Without the pinned walk: panels stack. */
	html:not([data-motion='on']) .walk,
	.walk[data-stacked] {
		height: auto;
