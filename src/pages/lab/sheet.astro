							<span>For</span>
						</div>
						{OFFERS.map((offer) => (
							<div class="border-b border-outline-gray-1 last:border-b-0">
								<div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 bg-surface-gray-1 px-4 py-2 text-sm">
									<Icon name="chevron-down" size={14} class="text-ink-gray-5" />
									<h3 class="font-medium text-ink-gray-9">{offer.title}</h3>
									<span class="font-data text-xs text-ink-gray-5">{offer.items.length}</span>
									<p class="basis-full pl-[22px] text-p-xs text-ink-gray-6 md:ml-auto md:basis-auto md:pl-0">{offer.summary}</p>
								</div>
								<ul class="divide-y divide-outline-gray-1">
									{offer.items.map((item, index) => (
										<li class="flex items-center justify-between gap-4 px-4 py-2.5 pl-[38px]">
											<span class="text-p-sm text-ink-gray-8">{item}</span>
											<span class:list={['inline-flex h-6 shrink-0 items-center rounded-full px-2 text-xs', offer.id === 'systems' ? 'bg-surface-blue-2 text-ink-blue-8' : 'bg-surface-violet-2 text-ink-violet-8']}>
												{WHO[offer.id][index]}
											</span>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				</section>

				<section id="partners" aria-labelledby="partners-title" class="flex scroll-mt-24 flex-col gap-5">
					<div class="flex flex-col gap-2">
						<h2 id="partners-title" class={sectionTitle}>Who we have worked with</h2>
						<p class="max-w-[60ch] text-p-base text-ink-gray-6">The same list, kept as a system would keep it. Sort it by any column.</p>
					</div>
					<div class="overflow-hidden rounded-5 border border-outline-gray-1" data-sortable>
						<div class="partner-cols h-9 items-center border-b border-outline-gray-1 bg-surface-gray-1 px-4 text-sm text-ink-gray-5">
							{['Organisation', 'Sector', 'Where'].map((label, index) => (
								<button type="button" data-sort={index} aria-label={`Sort by ${label}`} class:list={['flex items-center gap-1 text-left hover:text-ink-gray-9', index === 2 && 'max-sm:hidden']}>
									{label}<Icon name="chevrons-up-down" size={12} />
								</button>
							))}
							<span class="max-md:hidden">What we did</span>
						</div>
						<ul data-sort-body class="divide-y divide-outline-gray-1">
							{PARTNERS.map((partner) => (
								<li class="partner-cols items-center px-4 py-3" data-values={JSON.stringify([partner.name, partner.sector, partner.place])}>
									<span class="flex min-w-0 flex-col">
										<span class="truncate text-base-medium text-ink-gray-9">{isTBD(partner.name) ? <Tbd note="partner name" /> : partner.name}</span>
										{partner.fullName && <span class="truncate text-xs text-ink-gray-5">{isTBD(partner.fullName) ? <Tbd note="full name" /> : partner.fullName}</span>}
									</span>
									<span class="text-sm text-ink-gray-7">{isTBD(partner.sector) ? <Tbd /> : partner.sector}</span>
									<span class="text-sm text-ink-gray-6 max-sm:hidden">{isTBD(partner.place) ? <Tbd /> : partner.place}</span>
									<span class="text-sm text-ink-gray-7 max-md:hidden">{isTBD(partner.work) ? <Tbd note="what we built" /> : <span class="line-clamp-2">{partner.work}</span>}</span>
								</li>
							))}
						</ul>
					</div>
				</section>

				<section id="open-source" aria-labelledby="oss-title" class="grid scroll-mt-24 gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-center">
					<div class="flex flex-col gap-4">
						<h2 id="oss-title" class={sectionTitle}>Built on open source we help build</h2>
						<p class="max-w-[48ch] text-p-lg text-ink-gray-6">
							Frappe Framework and ERPNext are open source, and our team works on them. No per-seat licences, and
							the code is yours to take anywhere.
						</p>
						<ul class="flex flex-wrap gap-x-5 gap-y-2 pt-1">
							{STACK.map((item) => (
								<li class="flex items-center gap-2 text-sm text-ink-gray-8"><img src={item.src} alt="" width="20" height="20" class="size-5" />{item.label}</li>
							))}
						</ul>
						<a href={OPEN_SOURCE.href} class="flex items-center gap-1 text-sm text-ink-gray-6 underline hover:text-ink-gray-9">
							{OPEN_SOURCE.repos} open-source repos of our own <Icon name="arrow-up-right" size={13} />
						</a>
					</div>
					<!-- A chart dropped into a sheet: selected, with its handles showing. -->
					<figure class="chart-object relative rounded-1 border border-outline-gray-2 bg-surface-base p-5">
						<span class="handle left-[-4px] top-[-4px]"></span><span class="handle right-[-4px] top-[-4px]"></span>
						<span class="handle bottom-[-4px] left-[-4px]"></span><span class="handle bottom-[-4px] right-[-4px]"></span>
						<figcaption class="flex items-baseline justify-between gap-3 pb-4">
							<span class="text-base-semibold text-ink-gray-9">Pull requests merged into Frappe, by year</span>
							<span class="font-data text-xs text-ink-gray-5">=SUM(B2:B7) {CONTRIBUTIONS.total.toLocaleString('en-IN')}</span>
						</figcaption>
						<div class="flex h-52 items-end gap-3" data-bars>
							{CONTRIBUTIONS.byYear.map((row) => (
								<div class="flex h-full flex-1 flex-col items-center justify-end gap-1.5">
									<span class="font-data text-xs text-ink-gray-7">{row.count}</span>
									<span data-bar class:list={['w-full origin-bottom', row.year === '2026' ? 'bg-surface-blue-8' : 'bg-surface-blue-4']} style={`height: ${(row.count / maxYear) * 100}%`} />
									<span class="font-data text-xs text-ink-gray-5">{row.year}</span>
								</div>
							))}
						</div>
						<p class="pt-4 text-xs text-ink-gray-5">By our team, in frappe/* on GitHub. Checked {checked}.</p>
					</figure>
				</section>

				<section id="training" aria-labelledby="training-title" class="flex scroll-mt-24 flex-col gap-8">
					<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end">
						<h2 id="training-title" class={sectionTitle}>Then we train your team to run it.</h2>
						<p class="max-w-[52ch] text-p-lg text-ink-gray-6">{OFFERS[1].summary}</p>
					</div>
					<div class="grid gap-4 md:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
						<figure class="flex flex-col gap-2">
							<Image src={teachingPhoto} alt="A trainer at CS17 explains how DNS works, with a diagram on the screen behind him" widths={[640, 960, 1280]} sizes="(min-width: 768px) 640px, 100vw" class="aspect-[16/9] w-full rounded-5 object-cover" />
							<figcaption class="text-xs text-ink-gray-5">Teaching at CS17, our own programme in Jagdalpur.</figcaption>
						</figure>
						<figure class="flex flex-col gap-2">
							<Image src={aiPhoto} alt="Two CS17 students present a game, with a slide that says they used AI tools to make its graphics" widths={[480, 720]} sizes="(min-width: 768px) 420px, 100vw" class="aspect-[16/9] w-full rounded-5 object-cover md:aspect-auto md:h-full" />
							<figcaption class="text-xs text-ink-gray-5">CS17 students present a game they made with AI tools.</figcaption>
						</figure>
					</div>
					<div class="grid gap-x-10 gap-y-4 border-t border-outline-gray-1 pt-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
						<ul class="flex flex-col divide-y divide-outline-gray-1">
							{COURSES.map((course) => (
								<li class="flex items-baseline justify-between gap-4 py-2.5">
									<span class="text-p-sm text-ink-gray-8">{course.title}</span>
									<span class="shrink-0 font-data text-sm text-ink-gray-9">{course.learners.toLocaleString('en-IN')}</span>
								</li>
							))}
						</ul>
						<div class="flex flex-col gap-3">
							<p class="text-p-base text-ink-gray-7">
								Enrolments in Hussain's courses on Frappe School, October 2026. We are an official Frappe School partner, and we run{' '}
								{CS17.name}, an 18-month programme for young women in {HOME_TOWN}.
							</p>
							<div class="flex flex-wrap gap-3">
								<a href="/train-your-team" class="flex items-center gap-1 text-base text-ink-gray-8 underline hover:text-ink-gray-9">Training for teams <Icon name="arrow-right" size={14} /></a>
								<a href={CS17.href} class="flex items-center gap-1 text-base text-ink-gray-8 underline hover:text-ink-gray-9">cs17.org <Icon name="arrow-up-right" size={14} /></a>
							</div>
						</div>
					</div>
				</section>

				<section id="funders" aria-labelledby="funders-title" class="flex scroll-mt-24 flex-col gap-5">
					<div class="flex flex-col gap-2">
						<h2 id="funders-title" class={sectionTitle}>{FUNDERS.title}</h2>
						<p class="max-w-[60ch] text-p-base text-ink-gray-6">{FUNDERS.body}</p>
					</div>
					<div class="overflow-hidden rounded-5 border border-outline-gray-1">
						<div class="flex h-10 items-center gap-1.5 border-b border-outline-gray-1 px-4 text-sm">
							<span class="text-ink-gray-5">Reports</span>
							<Icon name="chevron-right" size={13} class="text-ink-gray-4" />
							<span class="font-medium text-ink-gray-9">All grantees</span>
							<span class="ml-auto rounded-full bg-surface-gray-2 px-1.5 py-0.5 text-[11px] text-ink-gray-6">Sample</span>
						</div>
						<table class="w-full text-left text-sm">
							<thead>
								<tr class="bg-surface-gray-1 text-xs text-ink-gray-5">
									<th scope="col" class="px-4 py-2 font-normal">Grantee</th>
									<th scope="col" class="px-4 py-2 text-right font-normal">Beneficiaries</th>
									<th scope="col" class="px-4 py-2 text-right font-normal">Visits this month</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-outline-gray-1">
								{PORTFOLIO.map((row) => (
									<tr>
										<td class="px-4 py-2.5 text-ink-gray-8">{row.name} <span class="text-ink-gray-5">· {row.place}</span></td>
										<td class="px-4 py-2.5 text-right font-data text-ink-gray-8">{row.people}</td>
										<td class="px-4 py-2.5 text-right font-data text-ink-gray-8">{row.visits}</td>
									</tr>
								))}
								<tr class="bg-surface-gray-1">
									<td class="px-4 py-2.5 font-medium text-ink-gray-9">All grantees</td>
									<td class="px-4 py-2.5 text-right font-data font-medium text-ink-gray-9">{PORTFOLIO.reduce((sum, row) => sum + row.people, 0)}</td>
									<td class="px-4 py-2.5 text-right font-data font-medium text-ink-gray-9">{PORTFOLIO.reduce((sum, row) => sum + row.visits, 0)}</td>
								</tr>
							</tbody>
						</table>
						<div class="flex flex-wrap items-center justify-between gap-3 border-t border-outline-gray-1 px-4 py-3">
							<p class="text-p-xs text-ink-gray-6">Every grantee on the same system, so the totals add up.</p>
							<Button href={CTA.meetHref} variant="outline">Talk about a portfolio <Icon name="arrow-up-right" size={14} /></Button>
						</div>
					</div>
				</section>

				<div class="rounded-5 border border-outline-gray-1 bg-surface-base p-5 sm:p-8">
					<IntakeCompact />
				</div>

				<footer class="sheet-footer" aria-label="About BWH">
					<span class="footer-rownum" aria-hidden="true">{TABLE_FIRST_ROW + MESS.length + 1}</span>
					<span class="footer-cell font-medium text-ink-gray-9">{LEGAL_NAME}</span>
					<span class="footer-cell">{HOME_TOWN}</span>
					<a href="/blog" class="footer-cell">Blog</a>
					<a href={YOUTUBE.href} class="footer-cell">YouTube</a>
					<a href={OPEN_SOURCE.href} class="footer-cell">GitHub</a>
					<a href={CTA.meetHref} class="footer-cell">Book a call</a>
				</footer>
			</div>
		</main>

		<!-- Sheet tabs, which are the page's sections, and the status bar. -->
		<nav aria-label="Sections" data-print-hide class="fixed inset-x-0 bottom-0 z-30 flex h-9 items-stretch border-t border-outline-gray-2 bg-surface-gray-1 text-sm">
			<div class="flex min-w-0 flex-1 items-stretch overflow-x-auto [scrollbar-width:none]">
				{TABS.map((tab) => (
					<a href={`#${tab.id}`} data-tab={tab.id} class="flex shrink-0 items-center border-r border-outline-gray-2 px-3 text-ink-gray-6 no-underline transition-colors hover:bg-surface-gray-2 hover:text-ink-gray-9 aria-[current=true]:bg-surface-base aria-[current=true]:font-medium aria-[current=true]:text-ink-gray-9 aria-[current=true]:shadow-[inset_0_2px_0_var(--ink-blue-6)]">
						{tab.label}
					</a>
				))}
				<span class="flex shrink-0 items-center px-3 italic text-ink-gray-5" aria-hidden="true">Copy of FINAL (3)</span>
			</div>
			<p class="flex shrink-0 items-center gap-2 border-l border-outline-gray-2 px-2.5 font-data text-[11px] text-ink-gray-5 md:hidden">
				<span>Count {NAMED_PARTNERS.length} · Sum {CONTRIBUTIONS.total.toLocaleString('en-IN')}</span>
			</p>
			<p class="hidden shrink-0 items-center gap-4 border-l border-outline-gray-2 px-4 font-data text-xs text-ink-gray-5 md:flex">
				<span>Count: {NAMED_PARTNERS.length} partners</span>
				<span>Sum: {CONTRIBUTIONS.total.toLocaleString('en-IN')} PRs merged</span>
			</p>
		</nav>
	</div>
</LabLayout>

<style>
	.sheet-page {
		--row: 30px;
		--rownum: 2.5rem;
		--sheet-template: minmax(9rem, 1.3fr) minmax(6rem, 0.9fr) minmax(7rem, 1fr) minmax(6.5rem, 0.9fr) minmax(5.5rem, 0.7fr) minmax(5.5rem, 0.7fr) minmax(8rem, 1.4fr);
		--app-template: minmax(0, 2fr) 7rem 6rem 5rem 4rem;
		padding-bottom: 36px;
	}
	@media (max-width: 639px) {
		.sheet-page {
			--row: 28px;
			--rownum: 1.75rem;
			--sheet-template: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.8fr);
			--app-template: minmax(0, 1fr) 6rem;
		}
		/* Wins over .cell and .colhead, which set display later in this sheet. */
		.c-hide {
			display: none !important;
		}
	}

	/* The scene is tall; the stage pins inside it. */
	.sheet-scene {
		height: 360vh;
	}
	.sheet-stage {
		position: sticky;
		top: 77px;
		height: calc(100vh - 77px - 36px);
		height: calc(100dvh - 77px - 36px);
		min-height: 620px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: var(--surface-base);
	}
	html:not([data-motion='on']) .sheet-scene {
		height: auto;
	}
	html:not([data-motion='on']) .sheet-stage {
		position: relative;
		top: 0;
		height: auto;
		min-height: 0;
		padding-bottom: 5rem;
	}

	.sheet-band {
		display: flex;
		position: relative;
	}
	.sheet-cols {
		display: grid;
		grid-template-columns: var(--sheet-template);
		flex: 1;
		min-width: 0;
	}
	.app-cols {
		display: grid;
		grid-template-columns: var(--app-template);
		align-items: center;
		column-gap: 0.75rem;
	}
	.row-h {
		height: var(--row);
	}
	.rownums {
		display: flex;
		flex-direction: column;
		width: var(--rownum);
		flex-shrink: 0;
	}
	.rownum,
	.colhead {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--surface-gray-1);
		color: var(--ink-gray-5);
		font-family: GeistMono, ui-monospace, monospace;
		font-size: 11px;
		border-right: 1px solid var(--outline-gray-1);
		border-bottom: 1px solid var(--outline-gray-1);
	}
	.rownum {
		width: var(--rownum);
		flex-shrink: 0;
	}
	.corner {
		height: 100%;
	}
	.cell {
		display: flex;
		align-items: center;
		min-width: 0;
		padding: 0 0.5rem;
		font-size: 13px;
		color: var(--ink-gray-8);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		border-right: 1px solid var(--outline-gray-1);
		border-bottom: 1px solid var(--outline-gray-1);
	}
	.cell.relative {
		overflow: visible;
	}
	.cell.head {
		font-weight: 600;
		background: var(--surface-amber-2);
		color: var(--ink-gray-9);
	}
	.cell.hl {
		background: var(--surface-amber-1);
	}
	.cell.err {
		color: var(--ink-red-6);
		font-weight: 500;
	}
	.merged {
		min-height: calc(5 * var(--row));
	}
	.merged-frame {
		position: absolute;
		inset: 0;
		border-right: 1px solid var(--outline-gray-1);
		border-bottom: 1px solid var(--outline-gray-1);
		pointer-events: none;
	}
	.selection {
		position: absolute;
		inset: -1px;
		border: 2px solid var(--outline-blue-6);
		pointer-events: none;
	}
	.fill-handle {
		position: absolute;
		right: -4px;
		bottom: -4px;
		width: 7px;
		height: 7px;
		background: var(--surface-blue-8);
		border: 1px solid var(--surface-base);
	}
	.comment-mark {
		position: absolute;
		top: 0;
		right: 0;
		border-top: 7px solid var(--surface-red-7);
		border-left: 7px solid transparent;
	}
	.comment {
		font-family: InterVar, Inter, ui-sans-serif, system-ui, sans-serif;
		position: absolute;
		left: calc(100% - 4px);
		top: -6px;
		z-index: 5;
		white-space: nowrap;
		padding: 4px 8px;
		font-size: 12px;
		color: var(--ink-gray-8);
		background: var(--surface-amber-2);
		border: 1px solid var(--outline-amber-3);
		box-shadow: 0 2px 6px rgb(0 0 0 / 0.08);
	}
	@media (max-width: 639px) {
		.comment {
			left: auto;
			right: calc(100% - 6px);
			top: calc(100% - 2px);
		}
	}
	.filler-grid {
		background-image: repeating-linear-gradient(
			to bottom,
			transparent 0 calc(var(--row) - 1px),
			var(--outline-gray-1) calc(var(--row) - 1px) var(--row)
		);
	}
	.filler-col {
		border-right: 1px solid var(--outline-gray-1);
	}
	.filler-nums {
		align-self: stretch;
		background-image: repeating-linear-gradient(
			to bottom,
			transparent 0 calc(var(--row) - 1px),
			var(--outline-gray-1) calc(var(--row) - 1px) var(--row)
		);
		background-color: var(--surface-gray-1);
	}

	[data-b-layer] {
		pointer-events: none;
	}
	.wipe-line {
		position: absolute;
		top: 0;
		width: 2px;
		height: calc(var(--row) * 9);
		margin-left: -1px;
		background: var(--surface-blue-8);
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--surface-blue-8) 18%, transparent);
		opacity: 0;
		z-index: 4;
		pointer-events: none;
	}
	[data-b-row],
	[data-b-fade] {
		opacity: 0;
	}

	/* The other places the data lives. */
	.artifact {
		position: absolute;
		z-index: 6;
		pointer-events: none;
		will-change: transform, opacity;
	}
	.form-card {
		right: 4%;
		top: -96px;
		width: 220px;
		border-radius: 8px;
		background: var(--surface-elevation-2);
		border: 1px solid var(--outline-gray-2);
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.1);
		transform: rotate(2.5deg);
	}
	.chat {
		right: 24%;
		top: 52%;
		display: flex;
		flex-direction: column;
		gap: 6px;
		transform: rotate(-2deg);
	}
	.bubble {
		max-width: 230px;
		padding: 6px 10px;
		border-radius: 10px;
		font-size: 13px;
		color: var(--ink-gray-9);
		background: var(--surface-elevation-2);
		border: 1px solid var(--outline-gray-2);
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.08);
	}
	.bubble.mine {
		align-self: flex-end;
		background: var(--surface-green-2);
		border-color: var(--outline-green-2);
	}
	.terminal {
		right: 24%;
		top: calc(100% - 18px);
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 10px 12px;
		border-radius: 8px;
		background: #111214;
		font-family: GeistMono, ui-monospace, monospace;
		font-size: 12px;
		box-shadow: 0 10px 28px rgb(0 0 0 / 0.22);
		transform: rotate(1.5deg);
	}
	@media (max-width: 1023px) {
		.chat {
			right: 4%;
			top: 64%;
		}
		.form-card {
			top: -120px;
		}
	}
	@media (max-width: 639px) {
		/* Small enough to sit beside the evidence: the form and the chat in the
		   empty cells beside the total, the script over the last villages. */
		.artifact {
			scale: 0.62;
			transform-origin: top right;
		}
		.form-card {
			top: -110px;
			right: 2%;
		}
		.chat {
			top: -58px;
			right: 2%;
		}
		.terminal {
			top: calc(var(--row) * 6 + 4px);
			right: auto;
			left: 34%;
			transform-origin: top left;
		}
	}

	.sheet-footer {
		display: grid;
		grid-template-columns: 2.5rem repeat(6, minmax(0, 1fr));
		border-top: 1px solid var(--outline-gray-2);
		border-left: 1px solid var(--outline-gray-2);
		font-size: 13px;
	}
	.footer-rownum,
	.footer-cell {
		display: flex;
		align-items: center;
		min-height: 36px;
		padding: 0 0.625rem;
		border-right: 1px solid var(--outline-gray-2);
		border-bottom: 1px solid var(--outline-gray-2);
		color: var(--ink-gray-7);
	}
	.footer-rownum {
		justify-content: center;
		background: var(--surface-gray-1);
		font-family: GeistMono, ui-monospace, monospace;
		font-size: 11px;
		color: var(--ink-gray-5);
	}
	a.footer-cell {
		text-decoration: underline;
	}
	a.footer-cell:hover {
		background: var(--surface-gray-1);
		color: var(--ink-gray-9);
	}
	@media (max-width: 767px) {
		.sheet-footer {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.footer-rownum {
			display: none;
		}
	}
	.partner-cols {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr) minmax(0, 0.9fr) minmax(0, 1.6fr);
		column-gap: 1rem;
	}
	@media (max-width: 767px) {
		.partner-cols {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr) minmax(0, 0.9fr);
		}
	}
	@media (max-width: 639px) {
		.partner-cols {
			grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		}
	}

	.chart-object .handle {
		position: absolute;
		width: 8px;
		height: 8px;
		background: var(--surface-base);
		border: 1.5px solid var(--outline-blue-6);
	}
	.chart-object {
		outline: 1.5px solid var(--outline-blue-6);
		outline-offset: 3px;
	}

	@media print {
		.sheet-scene {
			height: auto;
		}
		.sheet-stage {
			position: relative;
			height: auto;
		}
	}
</style>

<script>
	import { animate, stagger } from 'motion';
	import { boot, EASE_OUT, motionAllowed, once } from '../../scripts/landing/motion';

	boot();

	const scene = document.querySelector<HTMLElement>('[data-scene]')!;
	const stage = scene.querySelector<HTMLElement>('[data-stage]')!;
	const header = document.querySelector<HTMLElement>('[data-header]')!;
	const caption = stage.querySelector<HTMLElement>('[data-caption]')!;
	const dots = stage.querySelectorAll<HTMLElement>('[data-dot]');
	const sourcesText = stage.querySelector<HTMLElement>('[data-sources-text]')!;
	const sourcesChip = stage.querySelector<HTMLElement>('[data-sources]')!;

	const chrome = [...document.querySelectorAll<HTMLElement>('[data-a-chrome]')];
	const mess = [...stage.querySelectorAll<HTMLElement>('[data-mess]')];
	const aRows = [...stage.querySelectorAll<HTMLElement>('[data-a-row]')];
	const bRows = [...stage.querySelectorAll<HTMLElement>('[data-b-row]')];
	const bFades = [...stage.querySelectorAll<HTMLElement>('[data-b-fade]')];
	const aFades = [...stage.querySelectorAll<HTMLElement>('[data-a-fade]')];
	const flyers = [...stage.querySelectorAll<HTMLElement>('[data-fly]')];
	const hdrA = [...header.querySelectorAll<HTMLElement>('[data-hdr-a]')];
	const hdrB = [...header.querySelectorAll<HTMLElement>('[data-hdr-b]')];
	const dup = stage.querySelector<HTMLElement>('[data-dup]');
	const wipe = stage.querySelector<HTMLElement>('[data-wipe]');
	const chipIcon = sourcesChip.querySelector('svg') ?? sourcesChip;
	const afterDup = [...stage.querySelectorAll<HTMLElement>('[data-after-dup]')];

	const CAPTIONS = [
		'Sound familiar? Eight rows, four ways to write “yes”, and a total nobody trusts.',
		'We listen first. Then every sheet, form and chat goes into one place.',
		'One record per person. The total is right because the data is.',
		'Then we train your team to run it. That is the part that lasts.',
	];

	const clamp = (value: number) => Math.min(1, Math.max(0, value));
	const seg = (p: number, from: number, to: number) => clamp((p - from) / (to - from));
	const ease = (t: number) => 1 - Math.pow(1 - t, 3);

	// Where each flying card ends up: the "Sources" chip.
	let targets: { dx: number; dy: number }[] = [];
	function measure() {
		flyers.forEach((el) => (el.style.transform = ''));
		const chip = chipIcon.getBoundingClientRect();
		targets = flyers.map((el) => {
			const box = el.getBoundingClientRect();
			return {
				dx: chip.left + chip.width / 2 - (box.left + box.width / 2),
				dy: chip.top + chip.height / 2 - (box.top + box.height / 2),
			};
		});
	}

	let step = -1;
	function render(p: number) {
		const chromeOut = ease(seg(p, 0.5, 0.7));
		chrome.forEach((el) => (el.style.opacity = String(1 - chromeOut)));
		hdrA.forEach((el) => (el.style.opacity = String(1 - ease(seg(p, 0.5, 0.66)))));
		hdrB.forEach((el) => (el.style.opacity = String(ease(seg(p, 0.58, 0.74)))));
		mess.forEach((el) => (el.style.opacity = String(1 - seg(p, 0.14, 0.24))));

		// Each card travels to the chip's icon and is gone before it arrives, so
		// the chip never sits under a shrunken card. The count rises as each lands.
		let merged = 0;
		flyers.forEach((el, i) => {
			const travel = seg(p, 0.12 + i * 0.06, 0.32 + i * 0.06);
			const t = ease(travel);
			const fade = Math.min(1, Math.max(0, (t - 0.5) / 0.4));
			const rot = Number(el.dataset.rot ?? 0) * (1 - t);
			const { dx, dy } = targets[i] ?? { dx: 0, dy: 0 };
			el.style.transform = `translate(${dx * t}px, ${dy * t}px) rotate(${rot}deg) scale(${1 - 0.7 * t})`;
			el.style.opacity = String(1 - fade);
			el.style.filter = fade > 0 ? `blur(${fade * 6}px)` : '';
			if (fade >= 1) merged += 1;
		});
		sourcesText.textContent = `Sources: ${merged} merged`;

		const rowHeight = aRows[0]?.offsetHeight ?? 30;
		if (dup) {
			const d = ease(seg(p, 0.33, 0.42));
			dup.style.opacity = String(1 - d);
			dup.style.transform = `scaleY(${1 - d})`;
			dup.style.transformOrigin = 'top';
			afterDup.forEach((el) => (el.style.translate = `0 ${-rowHeight * d}px`));
		}
		// Sheet rows and list rows share one straight wipe, with the edge line as
		// its front: left of the line is the system, right of it the sheet.
		const rowT = (_i: number) => ease(seg(p, 0.42, 0.62));
		aRows.forEach((el, i) => {
			const t = rowT(i);
			// No clip at rest: it would also clip the comments that hang off a row.
			el.style.clipPath = t > 0 ? `inset(0 0 0 ${t * 100}%)` : '';
		});
		bRows.forEach((el, i) => {
			const t = rowT(i);
			el.style.opacity = t > 0 ? '1' : '0';
			el.style.clipPath = `inset(0 ${(1 - t) * 100}% 0 0)`;
		});
		if (wipe) {
			const t = rowT(4);
			wipe.style.left = `${t * 100}%`;
			wipe.style.opacity = t > 0 && t < 1 ? '1' : '0';
		}
		aFades.forEach((el) => {
			const [from, to] = (el.dataset.aFade ?? '0 1').split(' ').map(Number);
			el.style.opacity = String(1 - ease(seg(p, from, to)));
		});
		bFades.forEach((el) => {
			const [from, to] = (el.dataset.bFade ?? '0 1').split(' ').map(Number);
			const t = ease(seg(p, from, to));
			el.style.opacity = String(t);
			el.style.translate = `0 ${(1 - t) * 6}px`;
		});

		const next = p < 0.22 ? 0 : p < 0.48 ? 1 : p < 0.8 ? 2 : 3;
		if (next !== step) {
			step = next;
			caption.textContent = CAPTIONS[step];
			dots.forEach((dot, i) => {
				dot.classList.toggle('bg-surface-blue-8', i <= step);
				dot.classList.toggle('bg-surface-gray-4', i > step);
			});
		}
	}

	if (motionAllowed()) {
		measure();
		let frame = 0;
		// Progress is how far the scene has scrolled under the header, over the
		// distance the pinned stage can travel inside it.
		const update = () => {
			frame = 0;
			const travel = scene.offsetHeight - stage.offsetHeight;
			render(clamp((header.offsetHeight - scene.getBoundingClientRect().top) / travel));
		};
		const queue = () => (frame ||= requestAnimationFrame(update));
		window.addEventListener('scroll', queue, { passive: true });
		window.addEventListener('resize', () => {
			measure();
			queue();
		});
		update();
	} else {
		// Reduced motion: no scroll scene. A Before / After toggle instead.
		const toggle = stage.querySelector<HTMLElement>('[data-toggle]')!;
		toggle.hidden = false;
		measure();
		const show = (p: number) => {
			render(p);
			toggle.querySelectorAll('button').forEach((button) => button.setAttribute('aria-pressed', String(Number(button.dataset.show) === p)));
		};
		toggle.querySelectorAll<HTMLButtonElement>('button').forEach((button) =>
			button.addEventListener('click', () => show(Number(button.dataset.show))),
		);
		show(0);
	}

	// The formula bar reads whatever cell you point at.
	const nameBox = header.querySelector('[data-name-box]')!;
	const formula = header.querySelector('[data-formula]')!;
	const DEFAULT = { ref: nameBox.textContent ?? 'A1', formula: formula.textContent ?? '' };
	stage.querySelectorAll<HTMLElement>('[data-cell][data-ref]').forEach((cell) => {
		cell.addEventListener('pointerenter', () => {
			nameBox.textContent = cell.dataset.ref ?? '';
			formula.textContent = cell.dataset.formula ?? '';
		});
		cell.addEventListener('pointerleave', () => {
			nameBox.textContent = DEFAULT.ref;
			formula.textContent = DEFAULT.formula;
		});
	});

	// Sheet tabs follow the section in view.
	const tabs = document.querySelectorAll<HTMLAnchorElement>('[data-tab]');
	const observer = new IntersectionObserver(
		(entries) =>
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				tabs.forEach((tab) => tab.setAttribute('aria-current', String(tab.dataset.tab === entry.target.id)));
			}),
		{ rootMargin: '-35% 0px -55% 0px' },
	);
	document.querySelectorAll('#sheet, #changes, #build, #partners, #open-source, #training, #tell-us').forEach((el) => observer.observe(el));

	// Sortable partner list.
	const body = document.querySelector<HTMLElement>('[data-sort-body]');
	let sortState = { column: -1, direction: 1 };
	document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((button) =>
		button.addEventListener('click', () => {
			if (!body) return;
			const column = Number(button.dataset.sort);
			sortState = { column, direction: sortState.column === column ? -sortState.direction : 1 };
			const items = [...body.children] as HTMLElement[];
			const value = (item: HTMLElement) => {
				const text = JSON.parse(item.dataset.values ?? '[]')[column] ?? '';
				return text === 'TBD' ? '￿' : text.toLowerCase();
			};
			items.sort((a, b) => value(a).localeCompare(value(b)) * sortState.direction);
			body.replaceChildren(...items);
			if (motionAllowed()) animate(items, { opacity: [0.3, 1] }, { duration: 0.25, delay: stagger(0.02) });
		}),
	);

	// The chart grows the first time it is seen; the change list follows.
	document.querySelectorAll<HTMLElement>('[data-bars]').forEach((chart) => {
		if (!motionAllowed()) return;
		const bars = chart.querySelectorAll<HTMLElement>('[data-bar]');
		bars.forEach((bar) => (bar.style.transform = 'scaleY(0)'));
		once(chart, () => animate(bars, { transform: ['scaleY(0)', 'scaleY(1)'] }, { duration: 0.7, ease: EASE_OUT, delay: stagger(0.06) }));
	});
	const changes = document.querySelector<HTMLElement>('[data-changes]');
	if (changes && motionAllowed()) {
		const items = changes.querySelectorAll<HTMLElement>('li');
		items.forEach((item) => (item.style.opacity = '0'));
		once(changes, () =>
			animate(items, { opacity: [0, 1], transform: ['translateX(-8px)', 'translateX(0)'] }, { duration: 0.5, ease: EASE_OUT, delay: stagger(0.06) }),
		);
	}
</script>
