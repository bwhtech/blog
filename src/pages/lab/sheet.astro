---
/**
 * Variant 2, Sheet → System: the page opens as the spreadsheet most
 * programmes run on. Scrolling pins it and turns it into one clean system:
 * the forms and chats fly into one place, the duplicate merges, and the
 * total that was wrong becomes right. The rest of the page lives in the app.
 *
 * The beneficiary rows are sample data, and the page labels them so.
 */
import { Image } from 'astro:assets';
import aiPhoto from '../../assets/landing/cs17-ai-presentation.jpg';
import teachingPhoto from '../../assets/landing/cs17-teaching.jpg';
import Button from '../../components/landing/Button.astro';
import Icon from '../../components/landing/Icon.astro';
import IntakeCompact from '../../components/landing/IntakeCompact.astro';
import Logo from '../../components/landing/Logo.astro';
import Tbd from '../../components/landing/Tbd.astro';
import {
	CHECKED_ON,
	CONTRIBUTIONS,
	COURSES,
	CS17,
	CTA,
	FUNDERS,
	HEADLINE,
	HOME_TOWN,
	LEGAL_NAME,
	OFFERS,
	OPEN_SOURCE,
	NAMED_PARTNERS,
	PARTNERS,
	STACK,
	YOUTUBE,
	isTBD,
} from '../../data/landing';
import LabLayout from '../../layouts/LabLayout.astro';

const COLS = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
const HEAD = ['Name', 'Village', 'Phone', 'Last visit', 'Visited?', 'Case', 'Notes'];
const HIDE_ON_MOBILE = new Set([2, 3, 5, 6]);

type MessRow = {
	cells: string[];
	dup?: boolean;
	error?: number;
	highlight?: number[];
	comment?: { col: number; text: string };
};

// Eight rows, four ways to write "yes", one person twice, and a formula error.
const MESS: MessRow[] = [
	{ cells: ['Lakshmi B.', 'Kondagaon', '98271 •••••', '12/03/26', 'yes', 'Food', 'see WA group'] },
	{ cells: ['Ramesh Netam', 'kondagaon ', '+91 94060•••••', '3 March', 'Y', 'food', ''] },
	{
		cells: ['Sunita Kashyap', 'Bastar', '—', '2026-03-04', 'done ✓', 'Shelter', 'dup? check w/ Priya'],
		highlight: [6],
		comment: { col: 4, text: 'Who changed this??' },
	},
	{ cells: ['Lakshmi Bai', 'Kondagaon', '98271 •••••', '12-3-2026', 'Yes', 'FOOD', ''], dup: true, highlight: [0] },
	{ cells: ['Manoj Baghel', 'Jagdalpur', '70004 •••••', '#VALUE!', '?', 'Health', ''], error: 3 },
	{ cells: ['Devki Mandavi', 'Bastar', '98931 •••••', 'Mar-5', 'no', 'Health', 'call back'] },
	{ cells: ['Anil Sori', 'Dantewada', '88710 •••••', '06/03', 'yes', 'Rescue', ''], highlight: [0, 1, 2, 3, 4, 5, 6] },
	{ cells: ['Geeta Poyam', 'Bijapur', '', '', '', 'Shelter', 'from Google Form'] },
];

type Status = 'Visited' | 'Due' | 'Follow up';
const CLEAN: { name: string; village: string; visit: string; status: Status; kind: string; who: string; merged?: boolean }[] = [
	{ name: 'Lakshmi Bai', village: 'Kondagaon', visit: '12 Mar 2026', status: 'Visited', kind: 'Food', who: 'PK', merged: true },
	{ name: 'Ramesh Netam', village: 'Kondagaon', visit: '3 Mar 2026', status: 'Visited', kind: 'Food', who: 'RS' },
	{ name: 'Sunita Kashyap', village: 'Bastar', visit: '4 Mar 2026', status: 'Visited', kind: 'Shelter', who: 'PK' },
	{ name: 'Manoj Baghel', village: 'Jagdalpur', visit: '—', status: 'Due', kind: 'Health', who: 'AN' },
	{ name: 'Devki Mandavi', village: 'Bastar', visit: '5 Mar 2026', status: 'Follow up', kind: 'Health', who: 'AN' },
	{ name: 'Anil Sori', village: 'Dantewada', visit: '6 Mar 2026', status: 'Visited', kind: 'Rescue', who: 'RS' },
	{ name: 'Geeta Poyam', village: 'Bijapur', visit: '—', status: 'Due', kind: 'Shelter', who: 'PK' },
];
const tone = (status: Status) =>
	status === 'Visited'
		? 'bg-surface-green-2 text-ink-green-8'
		: status === 'Due'
			? 'bg-surface-amber-2 text-ink-amber-8'
			: 'bg-surface-blue-2 text-ink-blue-8';
const visited = CLEAN.filter((row) => row.status === 'Visited').length;
const due = CLEAN.filter((row) => row.status === 'Due').length;

const TABLE_FIRST_ROW = 10;
const TABS = [
	{ id: 'sheet', label: 'The mess' },
	{ id: 'changes', label: 'What changes' },
	{ id: 'build', label: 'What we build' },
	{ id: 'partners', label: 'Partners' },
	{ id: 'open-source', label: 'Open source' },
	{ id: 'training', label: 'Training' },
	{ id: 'tell-us', label: 'Tell us' },
];

const CHANGES = [
	{ before: 'Fourteen Excel sheets', after: 'One beneficiary register' },
	{ before: 'Google Forms and WhatsApp updates', after: 'A field app on the phone' },
	{ before: 'Reports stitched together for days', after: 'Reports from live data' },
	{ before: 'A script nobody understands', after: 'Automations you can read' },
	{ before: 'Attendance in a register', after: 'Frappe HR' },
	{ before: 'Grants in Tally and email', after: 'ERPNext accounts and grants' },
];

// Who uses each part, by offer. Same order as OFFERS[].items.
const WHO: Record<string, string[]> = {
	systems: ['Leadership', 'Programme team', 'Field team', 'MEL team', 'HR team', 'Finance team'],
	training: ['Developers', 'HR team', 'Finance team', 'Developers', 'Everyone'],
	ai: ['Teachers', 'Students', 'Your team'],
};

// Sample grantees for the portfolio report.
const PORTFOLIO = [
	{ name: 'Sample grantee A', place: 'Raipur', people: 212, visits: 486 },
	{ name: 'Sample grantee B', place: 'Pune', people: 164, visits: 301 },
	{ name: 'Sample grantee C', place: 'Lucknow', people: 98, visits: 140 },
];

const maxYear = Math.max(...CONTRIBUTIONS.byYear.map((row) => row.count));
const checked = new Date(CHECKED_ON).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const sectionTitle = 'text-[28px] font-semibold leading-[1.15] tracking-[-0.025em] text-ink-gray-9 sm:text-[34px] [text-wrap:balance]';
---

<LabLayout
	title="Sheet → System"
	description="BWH turns the sheets, forms and scripts your programme runs on into one system your team owns."
	variant="sheet"
	switcherOffset={36}
>
	<div class="sheet-page" data-sheet-page>
		<!-- Header: the spreadsheet's title bar and formula bar, which become the app's. -->
		<header class="sticky top-0 z-30 border-b border-outline-gray-2 bg-surface-base" data-header>
			<div class="flex h-11 items-center gap-3 px-3 sm:px-4">
				<Logo size={24} />
				<div class="relative min-w-0 flex-1">
					<p data-hdr-a class="flex items-center gap-2 truncate text-base text-ink-gray-8">
						<span class="truncate">Beneficiaries_FINAL_v3 (2).xlsx</span>
						<span class="hidden items-center gap-1 text-xs text-ink-gray-5 md:inline-flex">
							<Icon name="cloud-off" size={13} />Last edit by someone who left
						</span>
					</p>
					<p data-hdr-b class="absolute inset-0 flex items-center gap-1.5 truncate text-base text-ink-gray-8 opacity-0">
						<span class="font-semibold text-ink-gray-9">BWH</span>
						<Icon name="chevron-right" size={14} class="text-ink-gray-4" />
						<span class="truncate">Your programme, one system</span>
					</p>
				</div>
				<Button href={CTA.meetHref} variant="ghost" class="max-sm:hidden">{CTA.secondary}</Button>
				<Button href="#tell-us" variant="primary">{CTA.primary}</Button>
			</div>
			<div class="relative h-8 border-t border-outline-gray-1 text-sm">
				<div data-hdr-a class="absolute inset-0 flex items-center">
					<span data-name-box class="flex h-full w-14 shrink-0 items-center justify-center border-r border-outline-gray-1 font-data text-xs text-ink-gray-7 sm:w-16">A1</span>
					<span class="flex h-full w-9 shrink-0 items-center justify-center border-r border-outline-gray-1 font-data text-xs italic text-ink-gray-5">fx</span>
					<span data-formula class="truncate px-3 font-data text-xs text-ink-gray-8">="{HEADLINE.title}"</span>
				</div>
				<div data-hdr-b class="absolute inset-0 flex items-center gap-2 px-3 opacity-0 sm:px-4">
					<Icon name="search" size={14} class="text-ink-gray-5" />
					<span class="text-sm text-ink-gray-5">Search beneficiaries, visits, cases</span>
					<span class="ml-auto hidden items-center gap-1.5 text-xs text-ink-gray-5 sm:flex"><span class="live-dot" aria-hidden="true"></span>Everyone sees the same data</span>
				</div>
			</div>
		</header>

		<main id="main-content">
			<!-- The scene. Tall on purpose: scrolling through it drives the change. -->
			<section id="sheet" data-scene aria-labelledby="sheet-title" class="sheet-scene relative">
				<div data-stage class="sheet-stage">
					<!-- Column letters -->
					<div class="sheet-band h-6" aria-hidden="true">
						<div class="rownum corner" data-a-chrome></div>
						<div class="sheet-cols" data-a-chrome>
							{COLS.map((col, index) => <div class:list={['colhead', HIDE_ON_MOBILE.has(index) && 'c-hide']}>{col}</div>)}
						</div>
					</div>

					<!-- Rows 1 to 5, merged: the headline. -->
					<div class="sheet-band">
						<div class="rownums" data-a-chrome aria-hidden="true">
							{[1, 2, 3, 4, 5].map((row) => <div class="rownum flex-1">{row}</div>)}
						</div>
						<div class="relative min-w-0 flex-1">
							<div
								data-cell
								data-ref="A1"
								data-formula={`="${HEADLINE.title}"`}
								class="merged relative flex flex-col gap-3 px-4 py-5 sm:px-6 sm:py-7"
							>
								<span class="merged-frame" data-a-chrome aria-hidden="true"></span>
								<span class="selection" data-a-chrome aria-hidden="true"><span class="fill-handle"></span></span>
								<h1
									id="sheet-title"
									class="max-w-[18ch] text-[36px] font-semibold leading-[1.04] tracking-[-0.035em] text-ink-gray-9 [text-wrap:balance] sm:text-[52px] lg:text-[60px]"
								>
									{HEADLINE.title}
								</h1>
								<p class="max-w-[58ch] text-p-base text-ink-gray-6 sm:text-p-lg">{HEADLINE.lede}</p>
							</div>
						</div>
					</div>

					<!-- Rows 6 to 9: a total nobody trusts, which becomes the app's toolbar and KPIs. -->
					<div class="sheet-band">
						<div class="rownums" data-a-chrome aria-hidden="true">
							{[6, 7, 8, 9].map((row) => <div class="rownum row-h">{row}</div>)}
						</div>
						<div class="relative min-w-0 flex-1">
							<div data-a-layer data-a-fade="0.6 0.7" aria-hidden="true">
								{[0, 1, 2, 3].map((row) => (
									<div class="sheet-cols row-h">
										{COLS.map((_, col) => {
											const label = row === 1 && col === 0;
											const value = row === 1 && col === 1;
											return (
												<div
													class:list={['cell', HIDE_ON_MOBILE.has(col) && 'c-hide', label && 'font-medium text-ink-gray-8', value && 'relative font-data']}
													data-cell={label || value ? '' : undefined}
													data-ref={value ? 'B7' : label ? 'A7' : undefined}
													data-formula={value ? '=COUNTIF(E11:E18,"yes")' : label ? 'Visited this month' : undefined}
												>
													{label && 'Visited this month'}
													{value && (
														<>
															3
															<span class="comment-mark" data-mess />
															<span class="comment" data-mess>Priya says it is 5?</span>
														</>
													)}
												</div>
											);
										})}
									</div>
								))}
							</div>
							<!-- The system's toolbar and numbers. -->
							<div data-b-layer class="absolute inset-0 flex flex-col justify-center gap-2.5 px-3 sm:px-4">
								<div class="flex flex-wrap items-center gap-2">
									<div class="flex items-center gap-1 text-sm" role="presentation" data-b-fade="0.62 0.74">
										<span class="rounded-4 bg-surface-gray-2 px-2 py-1 text-ink-gray-9">Beneficiaries</span>
										<span class="px-2 py-1 text-ink-gray-5 max-sm:hidden">Visits</span>
										<span class="px-2 py-1 text-ink-gray-5 max-sm:hidden">Cases</span>
										<span class="px-2 py-1 text-ink-gray-5">Reports</span>
									</div>
									<span data-sources data-b-fade="0.24 0.3" class="ml-auto inline-flex h-7 items-center gap-1.5 rounded-full border border-outline-gray-2 bg-surface-base px-2.5 text-xs text-ink-gray-7">
										<Icon name="git-merge" size={13} class="text-ink-blue-6" />
										<span data-sources-text>Sources: 0 merged</span>
									</span>
								</div>
								<dl class="grid grid-cols-4 divide-x divide-outline-gray-1 rounded-4 border border-outline-gray-1 bg-surface-base" data-b-fade="0.68 0.8">
									{[
										{ label: 'Beneficiaries', value: CLEAN.length },
										{ label: 'Visited', value: visited, tone: 'text-ink-green-7' },
										{ label: 'Due', value: due, tone: 'text-ink-amber-7' },
										{ label: 'Duplicates merged', value: 1 },
									].map((kpi) => (
										<div class="flex flex-col gap-0.5 px-3 py-1.5">
											<dt class="truncate text-xs text-ink-gray-5">{kpi.label}</dt>
											<dd class:list={['font-data text-lg leading-tight text-ink-gray-9', kpi.tone]}>{kpi.value}</dd>
										</div>
									))}
								</dl>
							</div>
						</div>
					</div>

					<!-- Rows 10 to 18: the register. -->
					<div class="sheet-band">
						<div class="rownums" data-a-chrome aria-hidden="true">
							{Array.from({ length: MESS.length + 1 }, (_, index) => <div class="rownum row-h">{TABLE_FIRST_ROW + index}</div>)}
						</div>
						<div class="relative min-w-0 flex-1">
							<!-- Before: the sheet -->
							<div data-a-layer role="table" aria-label="Sample data: the sheet before" class="relative">
								<div role="row" class="sheet-cols row-h" data-a-row data-i="0">
									{HEAD.map((cell, col) => (
										<div role="columnheader" class:list={['cell head', HIDE_ON_MOBILE.has(col) && 'c-hide']}>{cell}</div>
									))}
								</div>
								{MESS.map((row, index) => (
									<div
										role="row"
										class="sheet-cols row-h"
										data-a-row
										data-i={index + 1}
										data-dup={row.dup ? '' : undefined}
										data-after-dup={MESS.findIndex((r) => r.dup) < index ? '' : undefined}
									>
										{row.cells.map((cell, col) => (
											<div
												role="cell"
												data-cell
												data-ref={`${COLS[col]}${TABLE_FIRST_ROW + index + 1}`}
												data-formula={cell}
												class:list={[
													'cell',
													HIDE_ON_MOBILE.has(col) && 'c-hide',
													(col === 2 || col === 3) && 'font-data',
													row.highlight?.includes(col) && 'hl',
													row.error === col && 'err',
													row.comment?.col === col && 'relative',
												]}
											>
												{cell}
												{row.comment?.col === col && (
													<>
														<span class="comment-mark" data-mess />
														<span class="comment" data-mess>{row.comment.text}</span>
													</>
												)}
											</div>
										))}
									</div>
								))}
							</div>

							<!-- After: one list -->
							<div data-b-layer role="table" aria-label="Sample data: the same people in one system" class="absolute inset-x-0 top-0">
								<div role="row" class="app-cols row-h border-b border-outline-gray-1 bg-surface-gray-1 px-3 text-xs text-ink-gray-5 sm:px-4" data-b-row data-i="0">
									<span role="columnheader">Beneficiary</span>
									<span role="columnheader" class="max-sm:hidden">Last visit</span>
									<span role="columnheader">Status</span>
									<span role="columnheader" class="max-sm:hidden">Case</span>
									<span role="columnheader" class="max-sm:hidden text-right">Assigned</span>
								</div>
								{CLEAN.map((row, index) => (
									<div role="row" class="app-cols row-h border-b border-outline-gray-1 bg-surface-base px-3 sm:px-4" data-b-row data-i={index + 1}>
										<span role="cell" class="flex min-w-0 items-center gap-2">
											<span class="truncate text-sm font-medium text-ink-gray-9">{row.name}</span>
											<span class="truncate text-xs text-ink-gray-5 max-sm:hidden">{row.village}</span>
											{row.merged && (
												<span class="inline-flex h-5 shrink-0 items-center gap-1 rounded-full bg-surface-violet-2 px-1.5 text-[11px] text-ink-violet-8">
													<Icon name="git-merge" size={11} />2 merged
												</span>
											)}
										</span>
										<span role="cell" class="font-data text-xs text-ink-gray-7 max-sm:hidden">{row.visit}</span>
										<span role="cell">
											<span class:list={['inline-flex h-5 items-center rounded-full px-2 text-xs font-medium', tone(row.status)]}>{row.status}</span>
										</span>
										<span role="cell" class="text-xs text-ink-gray-7 max-sm:hidden">{row.kind}</span>
										<span role="cell" class="flex justify-end max-sm:hidden">
											<span class="flex size-6 items-center justify-center rounded-full bg-surface-gray-2 text-[11px] font-medium text-ink-gray-7">{row.who}</span>
										</span>
									</div>
								))}
							</div>

							<span data-wipe class="wipe-line" aria-hidden="true"></span>

							<!-- The other places the data lives. They fly into "Sources". -->
							<div class="artifact form-card" data-fly data-i="0" data-rot="2.5" aria-hidden="true">
								<span class="block h-1.5 rounded-t-[7px] bg-surface-violet-7"></span>
								<span class="flex flex-col gap-1 px-3 py-2.5">
									<span class="text-sm font-medium text-ink-gray-9">Field visit form (Copy 3)</span>
									<span class="text-xs text-ink-gray-5">214 responses</span>
									<span class="text-xs text-ink-red-5">Not linked to any sheet</span>
								</span>
							</div>
							<div class="artifact chat" data-fly data-i="1" data-rot="-2" aria-hidden="true">
								<span class="bubble">Didi, which sheet is the latest?</span>
								<span class="bubble mine">Use FINAL_v3. No wait, v4</span>
							</div>
							<div class="artifact terminal" data-fly data-i="2" data-rot="1.5" aria-hidden="true">
								<span class="text-[#9ca3af]">$ python merge_sheets.py</span>
								<span class="text-[#fca5a5]">KeyError: 'Village '</span>
								<span class="text-[#6b7280]"># written by a volunteer, 2023</span>
							</div>
						</div>
					</div>

					<!-- Rows below: empty sheet. -->
					<div class="sheet-band filler flex-1" aria-hidden="true">
						<div class="rownum filler-nums" data-a-chrome></div>
						<div class="sheet-cols filler-grid flex-1" data-a-chrome>
							{COLS.map((_, col) => <div class:list={['filler-col', HIDE_ON_MOBILE.has(col) && 'c-hide']}></div>)}
						</div>
					</div>

					<!-- Caption: where we are in the story. -->
					<div class="pointer-events-none absolute inset-x-0 bottom-3 z-10 flex justify-center px-3 sm:bottom-4 lg:justify-start lg:pl-14" data-print-hide>
						<div class="pointer-events-auto flex max-w-[640px] items-center gap-3 rounded-full border border-outline-gray-2 bg-surface-elevation-2 py-2 pl-3 pr-4 shadow-lg">
							<span class="flex shrink-0 gap-1" aria-hidden="true">
								{[0, 1, 2, 3].map((step) => <span data-dot={step} class="size-1.5 rounded-full bg-surface-gray-4 transition-colors duration-200" />)}
							</span>
							<p data-caption aria-live="polite" class="text-p-sm text-ink-gray-8">
								Sound familiar? Eight rows, four ways to write “yes”, and a total nobody trusts.
							</p>
							<span class="hidden shrink-0 rounded-full bg-surface-gray-2 px-2 py-0.5 text-[11px] text-ink-gray-6 sm:inline">Sample data</span>
							<div data-toggle hidden class="flex shrink-0 gap-1">
								<button type="button" data-show="0" aria-pressed="true" class="rounded-full px-2 py-0.5 text-xs text-ink-gray-7 aria-pressed:bg-surface-gray-10 aria-pressed:text-ink-base">Before</button>
								<button type="button" data-show="1" aria-pressed="false" class="rounded-full px-2 py-0.5 text-xs text-ink-gray-7 aria-pressed:bg-surface-gray-10 aria-pressed:text-ink-base">After</button>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- From here on, the page lives in the system. -->
			<div class="mx-auto flex max-w-[1120px] flex-col gap-24 px-4 pb-32 pt-20 sm:px-6">
				<section id="changes" aria-labelledby="changes-title" class="grid scroll-mt-24 gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
					<div class="flex flex-col gap-4">
						<h2 id="changes-title" class={sectionTitle}>The total was wrong because the data was.</h2>
						<p class="max-w-[48ch] text-p-lg text-ink-gray-6">
							Four people were visited, not three. A sheet cannot know that “Y”, “Yes” and “done” mean the same
							thing, or that Lakshmi B. and Lakshmi Bai are one person. A system can, because it holds one record per
							person.
						</p>
						<p class="text-p-sm text-ink-gray-5">The sheet above is sample data.</p>
					</div>
					<ol class="flex flex-col" data-changes>
						{CHANGES.map((change) => (
							<li class="grid grid-cols-[minmax(0,1fr)_2rem_minmax(0,1fr)] items-center gap-2 border-b border-outline-gray-1 py-3.5 first:border-t">
								<span class="text-p-sm text-ink-gray-6 line-through decoration-outline-gray-4">{change.before}</span>
								<Icon name="arrow-right" size={16} class="justify-self-center text-ink-blue-6" />
								<span class="text-base-medium text-ink-gray-9">{change.after}</span>
							</li>
						))}
					</ol>
				</section>

				<section id="build" aria-labelledby="build-title" class="flex scroll-mt-24 flex-col gap-6">
					<div class="flex flex-col gap-2">
						<h2 id="build-title" class:list={[sectionTitle, 'max-w-[22ch]']}>Tell us the problem. We work out the system with you.</h2>
						<p class="max-w-[60ch] text-p-base text-ink-gray-6">Everything we build and teach, grouped the way your system would group it.</p>
					</div>
					<div class="overflow-hidden rounded-5 border border-outline-gray-1">
						<div class="flex h-8 items-center justify-between border-b border-outline-gray-1 px-4 pl-[38px] text-xs text-ink-gray-5" aria-hidden="true">
