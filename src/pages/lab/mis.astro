<script>
	import { animate, stagger } from 'motion';
	import { boot, countUp, EASE_OUT, motionAllowed, once } from '../../scripts/landing/motion';

	boot();

	// The focal moment: arcs draw out from Jagdalpur to the field. It waits for
	// the small home marker to be in view, so it plays on screen at any height.
	const map = document.querySelector<SVGSVGElement>('[data-map]');
	const homeMarker = map?.querySelector('.mis-home');
	if (map && homeMarker && motionAllowed()) {
		once(
			homeMarker,
			() => {
				animate(homeMarker, { transform: ['scale(0.6)', 'scale(1)'] }, { duration: 0.45, ease: EASE_OUT });
				animate(map.querySelectorAll('.mis-arc'), { strokeDashoffset: [1, 0] }, { duration: 0.9, ease: EASE_OUT, delay: stagger(0.12, { startDelay: 0.25 }) });
			},
			0.6,
		);
	}

	document.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);

	// Bars grow from their baseline the first time each chart is in view.
	document.querySelectorAll<HTMLElement>('[data-bars]').forEach((chart) => {
		if (!motionAllowed()) return;
		// Motion throws on an empty selection, so charts without columns skip.
		const vertical = chart.querySelectorAll('[data-bar]');
		if (!vertical.length) return;
		vertical.forEach((bar) => ((bar as HTMLElement).style.transform = 'scaleY(0)'));
		once(chart, () => animate(vertical, { transform: ['scaleY(0)', 'scaleY(1)'] }, { duration: 0.7, ease: EASE_OUT, delay: stagger(0.06) }));
	});

	const gantt = document.querySelector('[data-gantt]');
	if (gantt && motionAllowed()) {
		const bars = gantt.querySelectorAll<HTMLElement>('[data-gantt-bar]');
		bars.forEach((bar) => (bar.style.transform = 'scaleX(0)'));
		once(gantt, () =>
			animate(bars, { transform: ['scaleX(0)', 'scaleX(1)'] }, { duration: 0.8, ease: EASE_OUT, delay: stagger(0.14) }),
		);
	}

	// Sidebar and section tabs follow the section in view.
	const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
	const sections = document.querySelectorAll<HTMLElement>('[data-section], #funders');
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				const id = entry.target.id;
				links.forEach((link) => link.setAttribute('aria-current', String(link.dataset.nav === id)));
				document
					.querySelector<HTMLElement>(`nav.overflow-x-auto [data-nav="${id}"]`)
					?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
			}
		},
		{ rootMargin: '-30% 0px -60% 0px' },
	);
	sections.forEach((section) => observer.observe(section));

	// Sector filters.
	const rows = document.querySelectorAll<HTMLElement>('[data-row]');
	const count = document.querySelector('[data-row-count]');
	const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	filters.forEach((button) =>
		button.addEventListener('click', () => {
			const sector = button.dataset.filter;
			filters.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
			let shown = 0;
			rows.forEach((row) => {
				const match = sector === 'all' || row.dataset.sector === sector;
				row.parentElement!.hidden = !match;
				if (match) {
					shown += 1;
					if (motionAllowed()) animate(row, { opacity: [0, 1] }, { duration: 0.25 });
				}
			});
			if (count) count.textContent = `${shown} ${shown === 1 ? 'row' : 'rows'}`;
		}),
	);

	// Pointing at a row lights up its pins on the map.
	const pinFor = (id: string) => document.querySelectorAll(`[data-pin][data-rows~="${id}"]`);
	rows.forEach((row) => {
		const on = () => pinFor(row.dataset.row!).forEach((pin) => pin.setAttribute('data-active', ''));
		const off = () => pinFor(row.dataset.row!).forEach((pin) => pin.removeAttribute('data-active'));
		row.addEventListener('pointerenter', on);
		row.addEventListener('pointerleave', off);
		row.addEventListener('focus', on);
		row.addEventListener('blur', off);
	});

	// The drawer's map: this partner's pins, and the arcs out from Jagdalpur.
	const drawerMap = document.querySelector<SVGSVGElement>('[data-drawer-map]');
	const drawerPlace = document.querySelector('[data-drawer-place]');
	function showPlace(id: string) {
		if (!drawerMap) return;
		const keys = [...document.querySelectorAll<SVGGElement>(`[data-map] [data-pin][data-rows~="${id}"]`)].map((pin) => pin.dataset.pin!);
		drawerMap.querySelectorAll<SVGElement>('[data-drawer-pin]').forEach((pin) => pin.toggleAttribute('data-active', keys.includes(pin.dataset.drawerPin!)));
		const arcs = [...drawerMap.querySelectorAll<SVGPathElement>('[data-drawer-arc]')];
		arcs.forEach((arc) => {
			const on = keys.includes(arc.dataset.drawerArc!);
			arc.toggleAttribute('data-active', on);
			arc.style.strokeDashoffset = on && !motionAllowed() ? '0' : '1';
		});
		const lit = arcs.filter((arc) => arc.hasAttribute('data-active'));
		if (lit.length && motionAllowed()) animate(lit, { strokeDashoffset: [1, 0] }, { duration: 0.7, ease: EASE_OUT, delay: 0.15 });
		const place = document.querySelector(`template[data-case="${id}"]`)?.content.querySelector('[data-place]')?.textContent?.trim();
		if (drawerPlace) drawerPlace.textContent = keys.length ? (place ?? '') : 'No single location on the map';
	}

	// Case-study drawer.
	const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]');
	const drawerBody = drawer?.querySelector('[data-drawer-body]');
	let opener: HTMLElement | null = null;
	rows.forEach((row) =>
		row.addEventListener('click', () => {
			const template = document.querySelector<HTMLTemplateElement>(`template[data-case="${row.dataset.row}"]`);
			if (!drawer || !drawerBody || !template) return;
			opener = row;
			drawerBody.replaceChildren(template.content.cloneNode(true));
			showPlace(row.dataset.row!);
			drawer.showModal();
			if (motionAllowed()) animate(drawer, { transform: ['translateX(24px)', 'translateX(0)'], opacity: [0, 1] }, { duration: 0.32, ease: EASE_OUT });
		}),
	);
	drawer?.querySelector('[data-drawer-close]')?.addEventListener('click', () => drawer.close());
	drawer?.addEventListener('click', (event) => {
		if (event.target === drawer) drawer.close();
	});
	drawer?.addEventListener('close', () => opener?.focus());

	document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
