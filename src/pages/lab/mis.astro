---
/**
 * Variant 1, Impact MIS: the landing page is a dashboard. The sidebar is the
 * navigation, the KPIs and charts are real (see src/data/landing.ts), and the
 * partner table opens each case study in a drawer.
 */
import { Image } from 'astro:assets';
import aiPhoto from '../../assets/landing/cs17-ai-presentation.jpg';
import studentsPhoto from '../../assets/landing/cs17-students.jpg';
import Button from '../../components/landing/Button.astro';
import FunderStrip from '../../components/landing/FunderStrip.astro';
import Icon from '../../components/landing/Icon.astro';
import IntakeCompact from '../../components/landing/IntakeCompact.astro';
import Logo from '../../components/landing/Logo.astro';
import Tbd from '../../components/landing/Tbd.astro';
import {
	CHECKED_ON,
	CONTRIBUTIONS,
	COURSES,
	CS17,
	CTA,
	HEADLINE,
	HOME_TOWN,
	LEGAL_NAME,
	OFFERS,
	OPEN_SOURCE,
	NAMED_PARTNERS,
	PARTNERS,
	PROCESS,
	STACK,
	TBD,
	YOUTUBE,
	isTBD,
	type PinKey,
} from '../../data/landing';
import indiaMap from '../../data/india-map.json';
import LabLayout from '../../layouts/LabLayout.astro';

const NAV = [
	{ id: 'overview', label: 'Overview', icon: 'layout-dashboard' },
	{ id: 'field', label: 'Systems in the field', icon: 'map-pin' },
	{ id: 'build', label: 'What we build', icon: 'blocks' },
	{ id: 'process', label: 'How we work', icon: 'chart-gantt' },
	{ id: 'open-source', label: 'Open source', icon: 'git-pull-request' },
	{ id: 'training', label: 'Training', icon: 'graduation-cap' },
	{ id: 'cs17', label: 'CS17', icon: 'school' },
	{ id: 'funders', label: 'For funders', icon: 'layers' },
];

type Row = {
	id: string;
	name: string;
	fullName?: string;
	sector: string;
	place: string;
	pins: PinKey[];
	work: string;
	outcome: string;
	quote: string;
	status: string;
	link?: { label: string; href: string };
	modules?: string[];
};

const STATUS: Record<string, string> = {
	apf: 'In use',
	oasis: 'Member',
};

const rows: Row[] = [
	...PARTNERS.map((partner) => ({ ...partner, status: STATUS[partner.id] ?? TBD })),
	{
		id: 'cs17',
		name: 'CS17',
		fullName: 'Our own programme',
		sector: 'Education',
		place: HOME_TOWN,
		pins: ['jagdalpur'],
		work: 'Software development training for young women: 18 months, residential, fully funded.',
		outcome: TBD,
		quote: TBD,
		status: 'Live',
	},
];

const sectors = [...new Set(rows.map((row) => row.sector).filter((sector) => !isTBD(sector)))];
const statusTone = (status: string) =>
	status === 'Live' || status === 'In use'
		? 'bg-surface-green-2 text-ink-green-8'
		: status === 'Member'
			? 'bg-surface-violet-2 text-ink-violet-8'
			: '';

// Map geometry. Arcs leave Jagdalpur and bend to the left of the line to
// each partner, so neighbouring arcs fan out instead of overlapping.
const points = indiaMap.points as Record<PinKey, [number, number]>;
const home = points.jagdalpur;
const pinRows = rows.filter((row) => row.id !== 'cs17' && row.pins.length);
const pins = [...new Set(pinRows.flatMap((row) => row.pins))].map((key) => ({
	key,
	x: points[key][0],
	y: points[key][1],
	rows: pinRows.filter((row) => row.pins.includes(key)).map((row) => row.id),
}));
const arcs = pins.map((pin) => {
	const mx = (home[0] + pin.x) / 2;
	const my = (home[1] + pin.y) / 2;
	const dx = pin.x - home[0];
	const dy = pin.y - home[1];
	const bend = 0.22;
	return { key: pin.key, d: `M${home[0]} ${home[1]} Q${mx - dy * bend} ${my + dx * bend} ${pin.x} ${pin.y}` };
});
const CITY: Record<PinKey, string> = {
	jagdalpur: 'Jagdalpur',
	bengaluru: 'Bengaluru',
	chennai: 'Chennai',
	ernakulam: 'Ernakulam',
	bhuj: 'Bhuj',
	gurugram: 'Gurugram',
};
const LABEL_SIDE: Partial<Record<PinKey, 'left' | 'right'>> = { bengaluru: 'left', ernakulam: 'left' };

const kpis = [
	{ label: 'Partner organisations', value: NAMED_PARTNERS.length, display: String(NAMED_PARTNERS.length), meta: `named on this page, ${PARTNERS.length - NAMED_PARTNERS.length} more to come` },
	{ label: 'Pull requests merged into Frappe', value: CONTRIBUTIONS.total, display: '1,043', meta: 'by our team, 2021 to today' },
	{ label: 'Enrolments in our largest course', value: COURSES[0].learners, display: '18,608', meta: 'on Frappe School' },
	{ label: 'YouTube subscribers', value: 10.9, display: YOUTUBE.subscribers, decimals: 1, suffix: 'K', meta: `${YOUTUBE.videos} videos, ${YOUTUBE.views} views` },
];

const activity = [
	{ when: 'Oct 2026', text: `${CONTRIBUTIONS.byYear.at(-1)?.count} pull requests merged into Frappe repositories this year`, icon: 'git-pull-request' },
	{ when: CS17.started, text: 'CS17’s first batch starts in Jagdalpur', icon: 'school' },
	{ when: 'Jul 2025', text: 'BWH Studios opens in Jagdalpur, Chhattisgarh', icon: 'house' },
	{ when: 'Oct 2022', text: 'Frappe Changemakers goes open source for the homeless care programme', icon: 'heart-handshake' },
];

const SOURCES = [
	{ name: 'GitHub, frappe/* repositories', backs: 'Pull requests', href: 'https://github.com/frappe' },
	{ name: 'Frappe School', backs: 'Enrolments', href: 'https://school.frappe.io/lms/courses' },
	{ name: 'YouTube, @BuildWithHussain', backs: 'Subscribers', href: YOUTUBE.href },
	{ name: 'cs17.org', backs: 'CS17', href: CS17.href },
	{ name: 'BWH blog', backs: 'Changemakers, BWH Studios', href: '/blog/announcements/introducing-bwh-studios/' },
];

const MODULES = [
	{ name: OFFERS[0].items[0], icon: 'chart-column', body: 'Numbers your board can trust, updated as the work happens.', who: 'Leadership' },
	{ name: OFFERS[0].items[1], icon: 'id-card', body: 'One record per person, with every visit, case and service on it.', who: 'Programme team' },
	{ name: OFFERS[0].items[2], icon: 'smartphone', body: 'Forms the field team fills on a phone. The office sees them at once.', who: 'Field team' },
	{ name: OFFERS[0].items[3], icon: 'clipboard-list', body: 'Indicators from your logframe, reports in the format your funder asks for.', who: 'MEL' },
	{ name: OFFERS[0].items[4], icon: 'users', body: 'Leave, attendance and salary slips in Frappe HR.', who: 'HR' },
	{ name: OFFERS[0].items[5], icon: 'hand-coins', body: 'Books, grant tracking and donation receipts in ERPNext.', who: 'Finance' },
];

const GANTT: Record<string, [number, number]> = {
	listen: [0, 0.16],
	map: [0.1, 0.3],
	build: [0.24, 0.76],
	train: [0.56, 0.9],
	handover: [0.84, 1],
};

const maxYear = Math.max(...CONTRIBUTIONS.byYear.map((row) => row.count));
const maxRepo = CONTRIBUTIONS.byRepo[0].count;
const maxLearners = COURSES[0].learners;
const checked = new Date(CHECKED_ON).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const panel = 'rounded-5 border border-outline-gray-1 bg-surface-base';
const panelHead = 'flex min-h-11 items-center justify-between gap-3 border-b border-outline-gray-1 px-4';
---

<LabLayout
	title="Impact MIS"
	description="BWH builds systems for nonprofits: MIS, dashboards, case management, and training for your team."
	variant="mis"
>
	<div class="mis lg:grid lg:grid-cols-[14rem_minmax(0,1fr)]">
		<!-- Sidebar: the page's navigation, drawn as the MIS workspace. -->
		<aside
			data-print-hide
			class="sticky top-0 hidden h-screen flex-col border-r border-outline-gray-1 bg-surface-sidebar lg:flex"
		>
			<div class="flex h-12 items-center gap-2.5 px-3">
				<Logo size={26} />
				<div class="flex min-w-0 flex-col">
					<span class="text-base-semibold leading-tight text-ink-gray-9">BWH</span>
					<span class="text-xs leading-tight text-ink-gray-5">Impact MIS</span>
				</div>
			</div>
			<nav aria-label="Sections" class="flex flex-1 flex-col gap-0.5 px-2 pt-2">
				{
					NAV.map((item) => (
						<a
							href={`#${item.id}`}
							data-nav={item.id}
							class="flex h-8 items-center gap-2 rounded-4 px-2 text-base text-ink-gray-7 no-underline transition-colors hover:bg-surface-gray-2 hover:text-ink-gray-9 aria-[current=true]:bg-surface-base aria-[current=true]:text-ink-gray-9 aria-[current=true]:shadow-sm"
						>
							<Icon name={item.icon} size={16} class="text-ink-gray-6" />
							{item.label}
						</a>
					))
				}
			</nav>
			<div class="flex flex-col gap-2 border-t border-outline-gray-1 p-3">
				<Button href="#tell-us" variant="primary" class="w-full">
					<Icon name="message-square-plus" size={15} />
					{CTA.primary}
				</Button>
				<Button href={CTA.meetHref} variant="ghost" class="w-full">{CTA.secondary}</Button>
				<p class="flex items-center gap-2 px-1 pt-1 text-xs text-ink-gray-5">
					<span class="live-dot" aria-hidden="true"></span>
					Data checked {checked}
				</p>
			</div>
		</aside>

		<div class="min-w-0">
			<!-- Top bar: breadcrumb, reporting period, export, the primary action. -->
			<header
				class="sticky top-0 z-30 border-b border-outline-gray-1 bg-surface-base"
			>
				<div class="flex h-12 items-center gap-3 px-3 sm:px-5">
					<a href="/lab/mis" class="flex items-center gap-2 no-underline lg:hidden" aria-label="BWH">
						<Logo size={24} />
						<span class="text-base-semibold text-ink-gray-9">BWH</span>
					</a>
					<nav aria-label="Breadcrumb" class="hidden items-center gap-1.5 text-base sm:flex">
						<span class="text-ink-gray-5 max-lg:hidden">BWH</span>
						<Icon name="chevron-right" size={14} class="text-ink-gray-4 max-lg:hidden" />
						<span class="text-ink-gray-9">Impact report</span>
					</nav>
					<span class="hidden text-sm text-ink-gray-5 md:inline">
						Reporting period <span class="font-data text-ink-gray-7">2021 – {new Date(CHECKED_ON).getFullYear()}</span>
					</span>
					<div class="ml-auto flex items-center gap-2" data-print-hide>
						<Button data-print variant="ghost" class="max-sm:hidden">
							<Icon name="printer" size={15} />
							Export
						</Button>
						<Button href="#tell-us" variant="primary">{CTA.primary}</Button>
					</div>
				</div>
				<!-- Section tabs replace the sidebar on small screens. -->
				<nav
					aria-label="Sections"
					data-print-hide
					class="flex gap-1 overflow-x-auto border-t border-outline-gray-1 px-3 py-1.5 [scrollbar-width:none] lg:hidden"
				>
					{
						NAV.map((item) => (
							<a
								href={`#${item.id}`}
								data-nav={item.id}
								class="flex h-7 shrink-0 items-center rounded-4 px-2 text-sm text-ink-gray-6 no-underline aria-[current=true]:bg-surface-gray-2 aria-[current=true]:text-ink-gray-9"
							>
								{item.label}
							</a>
						))
					}
				</nav>
			</header>

			<main id="main-content" class="mx-auto flex max-w-[1120px] flex-col gap-14 px-3 pb-28 pt-8 sm:px-5 sm:pt-10">
				<!-- Overview -->
				<section id="overview" data-section aria-labelledby="overview-title" class="flex scroll-mt-28 flex-col gap-8">
					<div class="flex flex-col gap-4">
						<h1
							id="overview-title"
							class="max-w-[16ch] text-[38px] font-semibold leading-[1.05] tracking-[-0.035em] text-ink-gray-9 [text-wrap:balance] sm:text-[56px]"
						>
							{HEADLINE.title}
						</h1>
						<p class="max-w-[60ch] text-p-lg text-ink-gray-6 sm:text-[17px] sm:leading-[1.6]">{HEADLINE.lede}</p>
						<div class="flex flex-wrap items-center gap-2 pt-1">
							<Button href="#tell-us" variant="primary" size="lg">
								{CTA.primary}
								<Icon name="arrow-right" size={16} />
							</Button>
							<Button href={CTA.meetHref} variant="outline" size="lg">{CTA.secondary}</Button>
						</div>
					</div>

					<dl
						class:list={[panel, 'grid grid-cols-2 divide-outline-gray-1 overflow-hidden max-md:[&>*:nth-child(-n+2)]:border-b max-md:[&>*:nth-child(odd)]:border-r md:grid-cols-4 md:divide-x']}
					>
						{
							kpis.map((kpi) => (
								<div class="flex flex-col gap-1.5 border-outline-gray-1 p-4 sm:p-5">
									<dt class="text-sm text-ink-gray-5">{kpi.label}</dt>
									<dd
										class="font-data text-[28px] font-medium leading-none tracking-[-0.02em] text-ink-gray-9 sm:text-[34px]"
										data-count={kpi.value}
										data-decimals={kpi.decimals}
										data-suffix={kpi.suffix}
									>
										{kpi.display}
									</dd>
									<dd class="text-xs text-ink-gray-5">{kpi.meta}</dd>
								</div>
							))
						}
					</dl>

					<div class="grid gap-4 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)]">
						<div class:list={[panel, 'flex flex-col']}>
							<div class={panelHead}>
								<h2 class="text-base-semibold text-ink-gray-9">Where our work runs</h2>
								<div class="flex items-center gap-3 text-xs text-ink-gray-5">
									<span class="flex items-center gap-1.5"
										><span class="size-2 rounded-full bg-surface-blue-8"></span>Partner</span
									>
									<span class="flex items-center gap-1.5"
										><span class="size-2 rounded-full bg-surface-violet-8"></span>Home</span
									>
								</div>
							</div>
							<div class="relative flex flex-1 items-center justify-center p-3 sm:p-5">
								<svg
									data-map
									viewBox={indiaMap.viewBox}
									class="h-auto w-full max-w-[440px]"
									role="img"
									aria-label={`Map of India showing partner locations: ${pins.map((pin) => CITY[pin.key]).join(', ')}, and our home in Jagdalpur.`}
								>
									<defs>
										<pattern id="mis-dots" width="7" height="7" patternUnits="userSpaceOnUse">
											<circle cx="3.5" cy="3.5" r="1.25" style="fill: var(--outline-gray-3)"></circle>
										</pattern>
									</defs>
									<path data-map-land d={indiaMap.d} fill="url(#mis-dots)"></path>
									<path
										d={indiaMap.d}
										fill="none"
										style="stroke: var(--outline-gray-3)"
										stroke-width="1"
										vector-effect="non-scaling-stroke"></path>
									{
										arcs.map((arc) => (
											<path
												data-arc={arc.key}
												d={arc.d}
												pathLength="1"
												fill="none"
												stroke-width="1.5"
												stroke-linecap="round"
												class="mis-arc"
											/>
										))
									}
									{
										pins.map((pin) => (
											<g data-pin={pin.key} data-rows={pin.rows.join(' ')} class="mis-pin" transform={`translate(${pin.x} ${pin.y})`}>
												<circle r="5" class="mis-pin-ripple" />
												<circle r="5.5" class="mis-pin-dot" />
												<text
													x={LABEL_SIDE[pin.key] === 'left' ? -10 : 10}
													y="4"
													text-anchor={LABEL_SIDE[pin.key] === 'left' ? 'end' : 'start'}
													class="mis-label"
												>
													{CITY[pin.key]}
												</text>
											</g>
										))
									}
									<g transform={`translate(${home[0]} ${home[1]})`} data-pin="jagdalpur" data-rows="cs17">
										<g class="mis-home">
											<circle r="6" class="mis-pin-ripple mis-home-ripple" />
											<circle r="7" class="mis-home-dot" />
											<text x="12" y="4" class="mis-label mis-label-home">Jagdalpur, home</text>
										</g>
									</g>
								</svg>
							</div>
						</div>

						<div class="flex flex-col gap-4">
						<div class:list={[panel, 'flex flex-col']}>
							<div class={panelHead}>
								<h2 class="text-base-semibold text-ink-gray-9">Activity</h2>
								<span class="font-data text-xs text-ink-gray-5">checked {checked}</span>
							</div>
							<ol class="flex flex-col px-4 py-2">
								{
									activity.map((item) => (
										<li class="relative flex gap-3 py-3 [&:not(:last-child)]:after:absolute [&:not(:last-child)]:after:bottom-[-4px] [&:not(:last-child)]:after:left-[13px] [&:not(:last-child)]:after:top-[38px] [&:not(:last-child)]:after:w-px [&:not(:last-child)]:after:bg-surface-gray-3">
											<span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-outline-gray-2 bg-surface-base text-ink-gray-6">
												<Icon name={item.icon} size={14} />
											</span>
											<div class="flex min-w-0 flex-col gap-0.5 pt-0.5">
												<p class="text-p-sm text-ink-gray-8">{item.text}</p>
												<p class="font-data text-xs text-ink-gray-5">{item.when}</p>
											</div>
										</li>
									))
								}
							</ol>
						</div>
						<div class:list={[panel, 'flex flex-1 flex-col']}>
							<div class={panelHead}>
								<h2 class="text-base-semibold text-ink-gray-9">Data sources</h2>
								<span class="font-data text-xs text-ink-gray-5">checked {checked}</span>
							</div>
							<ul class="divide-y divide-outline-gray-1">
								{
									SOURCES.map((source) => (
										<li>
											<a href={source.href} class="flex items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-surface-gray-1">
												<span class="min-w-0 flex-1 truncate text-sm text-ink-gray-8">{source.name}</span>
												<span class="shrink-0 text-xs text-ink-gray-5">{source.backs}</span>
												<Icon name="arrow-up-right" size={13} class="shrink-0 text-ink-gray-4" />
											</a>
										</li>
									))
								}
							</ul>
						</div>
						</div>
					</div>
				</section>

				<!-- Systems in the field: the partner table. -->
				<section id="field" data-section aria-labelledby="field-title" class="flex scroll-mt-28 flex-col gap-4">
					<div class="flex flex-col gap-1">
						<h2 id="field-title" class="text-2xl font-semibold tracking-[-0.01em] text-ink-gray-9">Systems in the field</h2>
						<p class="max-w-[62ch] text-p-base text-ink-gray-6">
							Organisations we have worked with, and the programme we run ourselves. Pick a row for the details.
						</p>
					</div>

					<div class:list={[panel, 'overflow-hidden']}>
						<div class="flex flex-wrap items-center gap-2 border-b border-outline-gray-1 px-3 py-2">
							<div role="group" aria-label="Filter by sector" class="flex flex-wrap gap-1" data-filters>
								<button type="button" data-filter="all" aria-pressed="true" class="mis-filter">All</button>
								{sectors.map((sector) => (
									<button type="button" data-filter={sector} aria-pressed="false" class="mis-filter">{sector}</button>
								))}
							</div>
							<span class="ml-auto font-data text-xs text-ink-gray-5" data-row-count aria-live="polite">{rows.length} rows</span>
						</div>

						<div class="text-base">
							<div aria-hidden="true" class="hidden border-b border-outline-gray-1 bg-surface-gray-1 md:block">
								<div class="mis-cols h-9 items-center px-3 text-sm text-ink-gray-5">
									<span>Organisation</span>
									<span>Sector</span>
									<span>Where</span>
									<span>What we did</span>
									<span class="text-right">Status</span>
								</div>
							</div>
							<ul aria-label="Partner organisations" class="divide-y divide-outline-gray-1">
								{
									rows.map((row) => (
										<li data-row-item={row.id}><button
											type="button"
											data-row={row.id}
											data-sector={row.sector}
											aria-haspopup="dialog"
											class="mis-cols group w-full items-center px-3 py-2.5 text-left transition-colors hover:bg-surface-gray-1 focus-visible:bg-surface-gray-1 md:min-h-14 md:py-2.5"
										>
											<span class="flex min-w-0 flex-col">
												<span class="text-base-medium text-ink-gray-9">
													{isTBD(row.name) ? <Tbd note="partner name" /> : row.name}
												</span>
												{row.fullName && (
													<span class="text-xs text-ink-gray-5">
														{isTBD(row.fullName) ? <Tbd note="full name" /> : row.fullName}
													</span>
												)}
											</span>
											<span class="max-md:hidden">
												{isTBD(row.sector) ? <Tbd /> : <span class="inline-flex h-6 items-center whitespace-nowrap rounded-4 bg-surface-gray-2 px-1.5 text-sm text-ink-gray-7">{row.sector}</span>}
											</span>
											<span class="text-sm text-ink-gray-6 max-md:hidden">{isTBD(row.place) ? <Tbd /> : row.place}</span>
											<span class="min-w-0 text-sm text-ink-gray-7 max-md:col-span-2 max-md:mt-1">
												{isTBD(row.work) ? <Tbd note="what we built" /> : <span class="line-clamp-2 md:line-clamp-1">{row.work}</span>}
											</span>
											<span class="flex items-center justify-end gap-2 max-md:row-start-1 max-md:col-start-2">
												{isTBD(row.status) ? <Tbd /> : (
													<span class:list={['inline-flex h-6 items-center gap-1.5 rounded-full px-2 text-xs font-medium', statusTone(row.status)]}>
														{(row.status === 'Live' || row.status === 'In use') && <span class="size-1.5 rounded-full bg-surface-green-7" />}
														{row.status}
													</span>
												)}
