		}
	}

	.mis-filter {
		display: inline-flex;
		height: 1.75rem;
		align-items: center;
		border-radius: 999px;
		padding: 0 0.625rem;
		font-size: 13px;
		color: var(--ink-gray-6);
		transition:
			background-color 150ms,
			color 150ms;
	}
	.mis-filter:hover {
		background: var(--surface-gray-2);
		color: var(--ink-gray-9);
	}
	.mis-filter[aria-pressed='true'] {
		background: var(--surface-gray-10);
		color: var(--ink-base);
	}

	.mis-arc {
		stroke: var(--outline-blue-4);
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}
	.mis-pin-dot {
		fill: var(--surface-blue-8);
		stroke: var(--surface-base);
		stroke-width: 2;
		transition: transform 200ms var(--lab-ease);
	}
	.mis-home-dot {
		fill: var(--surface-violet-8);
		stroke: var(--surface-base);
		stroke-width: 2.5;
	}
	.mis-pin-ripple {
		fill: none;
		stroke: var(--outline-blue-5);
		stroke-width: 1.5;
		transform-box: fill-box;
		transform-origin: center;
		animation: mis-ripple 2.6s var(--lab-ease) 1.6s 3 both;
	}
	.mis-home-ripple {
		stroke: var(--outline-violet-5);
	}
	@keyframes mis-ripple {
		from {
			transform: scale(1);
			opacity: 0.9;
		}
		to {
			transform: scale(3.6);
			opacity: 0;
		}
	}
	.mis-label {
		font-size: 13px;
		font-family: GeistMono, ui-monospace, monospace;
		fill: var(--ink-gray-7);
		stroke: var(--surface-base);
		stroke-width: 4px;
		paint-order: stroke;
		stroke-linejoin: round;
	}
	.mis-label-home {
		fill: var(--ink-violet-8);
	}
	.mis-pin[data-active] .mis-pin-dot {
		transform: scale(1.5);
		fill: var(--surface-blue-10);
	}
	.mis-pin[data-active] .mis-label {
		fill: var(--ink-gray-9);
	}

	html[data-motion='on'] .mis-arc {
		stroke-dashoffset: 1;
	}
