---
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import { Avatar, Badge, Button } from 'frappe-ui';
import ThemeSwitcher from '../components/islands/ThemeSwitcher.vue';
import TrainingPrograms from '../components/islands/TrainingPrograms.vue';
import { FAQS, ONE_SHOT, PRODUCTS, REVIEWS, TBD, TRACKS, TRAINERS } from '../data/training';
import AppLayout from '../layouts/AppLayout.astro';

/**
 * Splits a quote around the phrase it wants in bold. Doing it here rather than
 * storing markup keeps the review data plain text, so nothing needs `set:html`.
 */
function quoteParts({ quote, emphasis }: { quote: string; emphasis?: string }) {
	const at = emphasis ? quote.indexOf(emphasis) : -1;
	if (at === -1 || !emphasis) return { before: quote, bold: '', after: '' };
	return { before: quote.slice(0, at), bold: emphasis, after: quote.slice(at + emphasis.length) };
}

/**
 * Trainers are authors, so their avatars come from the authors collection and
 * through the image pipeline. `Avatar` takes a URL string rather than an
 * `ImageMetadata`, so the processed variant is resolved here.
 */
const AVATAR_SIZE = 112; // 56px on the page, doubled for a retina screen.

const trainers = await Promise.all(
	TRAINERS.map(async (trainer) => {
		const author = await getEntry('authors', trainer.authorId);
		if (!author) throw new Error(`Trainer is not an author: ${trainer.authorId}`);

		const avatar = await getImage({
			src: author.data.avatar,
			width: AVATAR_SIZE,
			height: AVATAR_SIZE,
			format: 'webp',
		});

		return { ...trainer, avatar: avatar.src };
	}),
);

const title = 'Train Your Team';
const description =
	'Hands-on training for teams that want to build, run, and get the most out of Frappeverse.';

// Every frappe-ui component below is rendered without a `client:*` directive:
// Astro prints its markup at build time and ships no JavaScript for it. Only
// TrainingPrograms, which switches tabs, actually hydrates.
---

<AppLayout title={title} description={description} ogImage="/og/train-your-team.jpg">
	<main id="main-content" class="mx-auto w-full max-w-[820px] px-4 pb-32 pt-14 sm:px-5 sm:pt-24">
		<section class="flex flex-col items-center text-center" aria-labelledby="page-title">
			<p class="text-xs-medium uppercase tracking-widest text-ink-gray-5">
				<a class="no-underline transition-colors hover:text-ink-gray-8" href="/">BWH</a>
				<span class="mx-1.5 text-ink-gray-4" aria-hidden="true">/</span>
				<span class="text-ink-gray-7">Training</span>
			</p>
			<!-- The credential sits above the headline rather than below the CTAs,
			     where it read as an orphan between the hero and the first section. -->
			<div
				class="mt-6 inline-flex items-center gap-2 rounded-5 border border-outline-gray-1 bg-surface-gray-1 py-1 pe-3 ps-1"
			>
				<img
					class="size-6 rounded-2"
					src="/media/train-your-team/frappe-school-logo.png"
					alt=""
					width="24"
					height="24"
					loading="lazy"
				/>
				<span class="text-xs text-ink-gray-6">
					Official <strong class="font-medium text-ink-gray-7">Frappe School</strong> training partner
				</span>
			</div>

			<h1
				id="page-title"
				class="mt-6 text-[32px] font-semibold leading-[1.15] tracking-tight text-ink-gray-9 sm:text-[38px] lg:whitespace-nowrap lg:text-[44px]"
			>
				Get your team ready for action.
			</h1>
			<p class="mt-5 max-w-[560px] text-p-lg text-ink-gray-6">{description}</p>

			<div class="mt-11 flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
				<Button link="/meet" label="Book A Call" variant="solid" theme="gray" size="md" />

				<!-- An in-page jump, so it stays a plain anchor: Button's `link` prop
				     always opens a new tab, which would break a fragment target. -->
				<a
					class="group inline-flex min-h-8 items-center gap-1.5 text-sm text-ink-gray-5 no-underline transition-colors hover:text-ink-gray-9"
					href="#build-your-training"
				>
					<span>Build your own training</span>
					<span
						class="lucide-arrow-down size-4 transition-transform group-hover:translate-y-0.5"
						aria-hidden="true"></span>
				</a>
			</div>
		</section>

		<section class="mt-24 sm:mt-32" aria-labelledby="programs-title">
			<h2 id="programs-title" class="text-2xl-semibold text-ink-gray-9">Programs</h2>
			<p class="mt-4 max-w-[560px] text-p-base text-ink-gray-6">
				Three tracks. Pick the one that matches where your team already is.
			</p>

			<div class="mt-10">
				<!-- client:visible: the tabs sit below the fold on every viewport. -->
				<TrainingPrograms tracks={TRACKS} client:visible />
			</div>
		</section>

		<!--
		  Same grey card as the rest of the page: it is a different kind of thing to
		  buy, not a louder one, so it is set apart by the badge and the flat rate
		  rather than by a tint.
		-->
		<section
			id="frappeverse-one-shot"
			class="mt-12 rounded-7 border border-outline-gray-1 bg-surface-gray-1 p-6 sm:mt-16 sm:p-8"
			aria-labelledby="one-shot-title"
		>
			<div class="flex flex-wrap items-center gap-3">
				<h2 id="one-shot-title" class="text-xl-semibold text-ink-gray-9">{ONE_SHOT.title}</h2>
				<Badge label={ONE_SHOT.format} theme="gray" variant="subtle" size="md" />
			</div>

			<p class="mt-4 max-w-[560px] text-p-base text-ink-gray-6">{ONE_SHOT.blurb}</p>

			<ul class="mt-6 flex flex-col gap-2.5">
				{
					ONE_SHOT.highlights.map((highlight) => (
						<li class="flex gap-2 text-p-sm text-ink-gray-7">
							<span
								class="lucide-check size-4 shrink-0 translate-y-0.5 text-ink-gray-5"
								aria-hidden="true"
							/>
							<span>{highlight}</span>
						</li>
					))
				}
			</ul>

			<!-- The rate sits on the CTA line rather than in a strip of its own: it is
			     one number, and the point of it is that nothing else qualifies it. -->
			<div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
				<Button
					link={ONE_SHOT.cta.href}
					label={ONE_SHOT.cta.label}
					variant="outline"
					theme="gray"
					size="md"
				/>
				<p class="text-base text-ink-gray-8">
					<span class="font-medium">{ONE_SHOT.price}</span>
					<span class="text-ink-gray-5"> {ONE_SHOT.priceNote}</span>
				</p>
			</div>

			<ul class="mt-8 flex flex-wrap items-center gap-2.5 border-t border-outline-gray-1 pt-6">
				{
					ONE_SHOT.products.map((key) => (
						<li>
							<img
								class="size-6"
								src={PRODUCTS[key].src}
								alt={PRODUCTS[key].label}
								title={PRODUCTS[key].label}
								width="24"
								height="24"
								loading="lazy"
							/>
						</li>
					))
				}
			</ul>
		</section>

		<section
			id="build-your-training"
			class="mt-12 scroll-mt-8 rounded-7 border border-outline-gray-1 bg-surface-gray-1 p-6 sm:mt-16 sm:p-8"
			aria-labelledby="custom-title"
		>
			<h2 id="custom-title" class="text-xl-semibold text-ink-gray-9">Build Your Training</h2>
			<p class="mt-4 max-w-[520px] text-p-base text-ink-gray-6">
				Have a custom requirement? Want to mix and match? We can build a training programme <em
					>just for you</em
				>.
			</p>
			<div class="mt-6">
				<Button link="/meet" label="Talk to us" variant="outline" theme="gray" size="md" />
			</div>
		</section>

		<section class="mt-24 sm:mt-32" aria-labelledby="team-title">
			<h2 id="team-title" class="text-2xl-semibold text-ink-gray-9">Learn from the best</h2>

			<ul class="mt-10 grid gap-5 sm:grid-cols-3">
				{
					trainers.map((trainer) => (
						<li class="rounded-6 border border-outline-gray-1 bg-surface-base p-6">
							<Avatar class="size-14" image={trainer.avatar} label={trainer.name} />
							<h3 class="mt-4 text-base font-medium text-ink-gray-8">
								{trainer.href ? (
									<a class="no-underline hover:underline" href={trainer.href}>
										{trainer.name}
									</a>
								) : (
									trainer.name
								)}
							</h3>
							<p class="mt-1 text-p-sm text-ink-gray-5">{trainer.role}</p>
							<p class="mt-3 text-p-sm text-ink-gray-6">{trainer.bio}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mt-24 sm:mt-32" aria-labelledby="reviews-title">
			<h2 id="reviews-title" class="text-2xl-semibold text-ink-gray-9">What learners say</h2>

			<ul class="mt-10 grid gap-5 sm:grid-cols-2">
				{
					REVIEWS.map((review) => {
						const { before, bold, after } = quoteParts(review);
						return (
						<li class="rounded-6 border border-outline-gray-1 bg-surface-base p-6">
							<div class="flex items-center gap-3">
								<Avatar class="size-9 shrink-0" image={review.avatar} label={review.name} />
								<div class="min-w-0">
									<p class="truncate text-base font-medium text-ink-gray-8">{review.name}</p>
									<p class="mt-1 truncate text-sm text-ink-gray-5">
										{review.context ?? 'BWH School Learner'}
									</p>
								</div>
							</div>

							{/* prose prose-v3: the same body type the blog posts use. */}
							<div class="prose prose-v3 mt-4 max-w-none">
								<p>
									{before}
									{bold && <strong>{bold}</strong>}
									{after}
								</p>
							</div>
						</li>
						);
					})
				}
			</ul>
		</section>

		<section class="mt-24 sm:mt-32" aria-labelledby="faq-title">
			<h2 id="faq-title" class="text-2xl-semibold text-ink-gray-9">FAQs</h2>

			{/*
			  Styled after frappe-ui's Accordion (`experimental/Accordion`): the same
			  divide-y list with no rule above the first row or below the last, the
			  same trigger type, chevron and focus ring, one step more vertical
			  padding because this is a marketing page rather than app chrome. It is
			  not that component — `experimental/**` sits outside the package's
			  Tailwind content contract, so its classes are never emitted here, and a
			  `details` element opens with no JavaScript at all.
			*/}
			<div class="mt-10 divide-y divide-outline-gray-1">
				{
					FAQS.map((faq) => (
						<details class="group">
							<summary class="flex cursor-pointer select-none list-none items-center gap-2 rounded-4 px-2 py-4 text-base font-medium text-ink-gray-8 outline-none transition-colors duration-150 hover:text-ink-gray-9 focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-outline-gray-3">
								<span class="min-w-0 flex-1">{faq.question}</span>
								<span
									class="lucide-chevron-down size-4 shrink-0 text-ink-gray-5 transition-transform duration-200 group-hover:text-ink-gray-8 group-open:rotate-180"
									aria-hidden="true"
								/>
							</summary>
							<p
								class={`px-2 pb-5 text-p-base ${faq.answer === TBD ? 'text-ink-gray-4' : 'text-ink-gray-6'}`}
							>
								{faq.answer}
							</p>
						</details>
					))
				}
			</div>
		</section>

		<section class="mt-24 text-center sm:mt-32" aria-labelledby="cta-title">
			<h2 id="cta-title" class="text-2xl-semibold text-ink-gray-9">
				Get your team ready for action.
			</h2>
			<div class="mt-6">
				<Button link="/meet" label="Book A Call" variant="outline" theme="gray" size="md" />
			</div>
		</section>

		<section class="mt-24 flex justify-center sm:mt-32" aria-label="Colour scheme">
			<!-- client:only: the active scheme lives in localStorage and matchMedia, so
			     the server cannot know it. Rendering it would guarantee a hydration
			     mismatch; skipping SSR is cheaper than reconciling one. -->
			<ThemeSwitcher client:only="vue" />
		</section>
	</main>
</AppLayout>
