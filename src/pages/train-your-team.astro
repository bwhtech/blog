---
import { Avatar, Button } from 'frappe-ui';
import TrainingPrograms from '../components/islands/TrainingPrograms.vue';
import { FAQS, REVIEWS, TBD, TRACKS, TRAINERS } from '../data/training';
import AppLayout from '../layouts/AppLayout.astro';

/**
 * Splits a quote around the phrase it wants in bold. Doing it here rather than
 * storing markup keeps the review data plain text, so nothing needs `set:html`.
 */
function quoteParts({ quote, emphasis }: { quote: string; emphasis?: string }) {
	const at = emphasis ? quote.indexOf(emphasis) : -1;
	if (at === -1 || !emphasis) return { before: quote, bold: '', after: '' };
	return { before: quote.slice(0, at), bold: emphasis, after: quote.slice(at + emphasis.length) };
}

const title = 'Train Your Team';
const description =
	'Hands-on training for teams that want to build, run, and get the most out of Frappeverse.';

// Every frappe-ui component below is rendered without a `client:*` directive:
// Astro prints its markup at build time and ships no JavaScript for it. Only
// TrainingPrograms, which switches tabs, actually hydrates.
---

<AppLayout title={title} description={description}>
	<main id="main-content" class="mx-auto w-full max-w-[820px] px-4 pb-32 pt-14 sm:px-5 sm:pt-24">
		<section class="flex flex-col items-center text-center" aria-labelledby="page-title">
			<p class="text-xs uppercase tracking-widest text-ink-gray-5">
				<a class="no-underline transition-colors hover:text-ink-gray-8" href="/">BWH</a>
				<span class="mx-1.5 text-ink-gray-4" aria-hidden="true">/</span>
				<span class="text-ink-gray-7">Training</span>
			</p>
			<h1
				id="page-title"
				class="mt-4 text-[32px] font-semibold leading-[1.15] tracking-tight text-ink-gray-9 sm:text-[38px] lg:whitespace-nowrap lg:text-[44px]"
			>
				Get your team ready for action.
			</h1>
			<p class="mt-5 max-w-[560px] text-p-lg text-ink-gray-6">{description}</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
				<Button link="/meet" label="Book A Call" variant="solid" theme="gray" size="lg" />

				<!-- An in-page jump, so it stays a plain anchor: Button's `link` prop
				     always opens a new tab, which would break a fragment target. -->
				<a
					class="group inline-flex min-h-8 items-center gap-1.5 text-sm text-ink-gray-5 no-underline transition-colors hover:text-ink-gray-9"
					href="#build-your-training"
				>
					<span>Build your own training</span>
					<span
						class="lucide-arrow-down size-4 transition-transform group-hover:translate-y-0.5"
						aria-hidden="true"></span>
				</a>
			</div>

			<div
				class="mt-10 inline-flex items-center gap-3 rounded-5 border border-outline-gray-1 bg-surface-gray-1 py-2 pe-4 ps-2"
			>
				<img
					class="size-8 rounded-3"
					src="/media/train-your-team/frappe-school-logo.png"
					alt="Frappe School"
					width="32"
					height="32"
					loading="lazy"
				/>
				<div class="text-sm text-ink-gray-7">
					Official <strong class="font-medium text-ink-gray-8">Frappe School</strong> training
					partner
				</div>
			</div>
		</section>

		<section class="mt-20 sm:mt-24" aria-labelledby="programs-title">
			<h2 id="programs-title" class="text-2xl-semibold text-ink-gray-9">Programs</h2>
			<p class="mt-3 max-w-[560px] text-p-base text-ink-gray-6">
				Three tracks. Pick the one that matches where your team already is.
			</p>

			<div class="mt-8">
				<!-- client:visible: the tabs sit below the fold on every viewport. -->
				<TrainingPrograms tracks={TRACKS} client:visible />
			</div>
		</section>

		<section
			id="build-your-training"
			class="mt-20 scroll-mt-8 rounded-7 border border-outline-gray-1 bg-surface-gray-1 p-6 sm:mt-24 sm:p-8"
			aria-labelledby="custom-title"
		>
			<h2 id="custom-title" class="text-xl-semibold text-ink-gray-9">Build Your Training</h2>
			<p class="mt-3 max-w-[520px] text-p-base text-ink-gray-6">
				Have a custom requirement? Want to mix and match? We can build a training programme <em
					>just for you</em
				>.
			</p>
			<div class="mt-6">
				<Button link="/meet" label="Talk to us" variant="outline" theme="gray" size="md" />
			</div>
		</section>

		<section class="mt-20 sm:mt-24" aria-labelledby="team-title">
			<h2 id="team-title" class="text-2xl-semibold text-ink-gray-9">Learn from the best</h2>
			<p class="mt-3 max-w-[560px] text-p-base text-ink-gray-6">TBD</p>

			<ul class="mt-8 grid gap-4 sm:grid-cols-3">
				{
					TRAINERS.map((trainer) => (
						<li class="rounded-6 border border-outline-gray-1 bg-surface-base p-5">
							<Avatar class="size-14" image={trainer.avatar} label={trainer.name} />
							<h3 class="mt-4 text-base font-medium text-ink-gray-8">
								{trainer.href ? (
									<a class="no-underline hover:underline" href={trainer.href}>
										{trainer.name}
									</a>
								) : (
									trainer.name
								)}
							</h3>
							<p
								class={`mt-1 text-p-sm ${trainer.role === TBD ? 'text-ink-gray-4' : 'text-ink-gray-6'}`}
							>
								{trainer.role}
							</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mt-20 sm:mt-24" aria-labelledby="reviews-title">
			<h2 id="reviews-title" class="text-2xl-semibold text-ink-gray-9">What learners say</h2>

			<ul class="mt-8 grid gap-4 sm:grid-cols-2">
				{
					REVIEWS.map((review) => {
						const { before, bold, after } = quoteParts(review);
						return (
						<li class="rounded-6 border border-outline-gray-1 bg-surface-base p-5">
							<div class="flex items-center gap-3">
								<Avatar class="size-9 shrink-0" image={review.avatar} label={review.name} />
								<div class="min-w-0">
									<p class="truncate text-base font-medium text-ink-gray-8">{review.name}</p>
									<p class="mt-1 truncate text-sm text-ink-gray-5">
										{review.context ?? 'BWH School Learner'}
									</p>
								</div>
							</div>

							{/* prose prose-v3: the same body type the blog posts use. */}
							<div class="prose prose-v3 mt-4 max-w-none">
								<p>
									{before}
									{bold && <strong>{bold}</strong>}
									{after}
								</p>
							</div>
						</li>
						);
					})
				}
			</ul>
		</section>

		<section class="mt-20 sm:mt-24" aria-labelledby="faq-title">
			<h2 id="faq-title" class="text-2xl-semibold text-ink-gray-9">FAQs</h2>

			<div class="mt-8 divide-y divide-outline-gray-1 border-y border-outline-gray-1">
				{
					FAQS.map((faq) => (
						<details class="group">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-base font-medium text-ink-gray-8">
								{faq.question}
								<span
									class="lucide-chevron-down size-4 shrink-0 text-ink-gray-5 transition-transform group-open:rotate-180"
									aria-hidden="true"
								/>
							</summary>
							<p
								class={`pb-4 text-p-base ${faq.answer === TBD ? 'text-ink-gray-4' : 'text-ink-gray-6'}`}
							>
								{faq.answer}
							</p>
						</details>
					))
				}
			</div>
		</section>

		<section class="mt-20 text-center sm:mt-24" aria-labelledby="cta-title">
			<h2 id="cta-title" class="text-2xl-semibold text-ink-gray-9">
				Get your team ready for action.
			</h2>
			<div class="mt-6">
				<Button link="/meet" label="Book A Call" variant="outline" theme="gray" size="lg" />
			</div>
		</section>
	</main>
</AppLayout>
